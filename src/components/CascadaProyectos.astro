---
/* Cascada del héroe de la portada v2: 4 capturas reales apiladas en plano (sin perspectiva ni rotación, que emborronan
   el texto de las capturas). La primera del arreglo es la del frente y el LCP; las otras tres van detrás, más chicas,
   decorativas y sin competir por la red. El layout (escenario, unidades cqi) vive en portada.css. */
import MarcoCaptura from './MarcoCaptura.astro';

interface Proyecto { t: string; cap: string; dominio: string }
interface Props {
  proyectos: Proyecto[];
  /** «2025–2026», de aniosPortafolio(). */
  anios: string;
  movil: { srcset: [string, number][]; width: number; height: number };
}
const { proyectos, anios, movil } = Astro.props;
if (proyectos.length !== 4) throw new Error(`CascadaProyectos espera 4 proyectos y recibió ${proyectos.length}`);
const [frente, ...atras] = proyectos;
---
<div class="pv2-cascada">
  <div class="pv2-cascada__escenario">
    <MarcoCaptura
      cap={frente.cap}
      dominio={frente.dominio}
      alt={`Web de ${frente.t}, ${frente.dominio}, hecha por Elemento Web`}
      anchos={[480, 800, 1000]}
      sizes="(min-width:1024px) 400px, (min-width:640px) calc(100vw - 64px), calc(100vw - 32px)"
      prioridad="alta"
      movil={movil}
      clase="pv2-cascada__marco pv2-cascada__marco--frente"
    />
    {atras.map((p, i) => (
      <MarcoCaptura cap={p.cap} dominio={p.dominio} alt="" sizes="340px" prioridad="baja" clase={`pv2-cascada__marco pv2-cascada__marco--${i + 1}`} />
    ))}
  </div>
  <p class="pv2-cascada__pie"><a href="/portafolio/"><span class="ew-data">Proyectos publicados · {anios}</span></a></p>
</div>
