---
/* Formulario de contacto reutilizable (home + /contacto/).
   Soporta DOS backends, en este orden de prioridad:
   1) Webhook n8n  → site.ts → contactForm.endpoint  (control total del correo)
   2) Web3Forms    → site.ts → contactForm.web3formsKey
   Sin ninguno configurado, el formulario avisa y empuja a WhatsApp.
   El workflow de n8n listo para importar está en docs/contacto-n8n/. */
import { contactForm } from '../lib/site';
const { services, budgets, web3formsKey, endpoint } = contactForm;
---
<div id="formulario" class="scroll-mt-28 glass rounded-3xl p-6 sm:p-8">
  <form id="cform" novalidate aria-describedby="cerr">
    <input type="hidden" name="access_key" value={web3formsKey} />
    <input type="hidden" name="subject" value="Nueva solicitud desde elementoweb.com" />
    <input type="hidden" name="from_name" value="Elemento Web — Web" />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-nombre">Nombre <span class="text-teal-deep" aria-hidden="true">*</span></label><input name="nombre" id="cf-nombre" autocomplete="name" required aria-required="true" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20" /><p id="err-nombre" class="cf-err mt-1 hidden text-xs font-medium text-red-700"></p></div>
      <div><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-empresa">Empresa <span class="text-teal-deep" aria-hidden="true">*</span></label><input name="empresa" id="cf-empresa" autocomplete="organization" required aria-required="true" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20" /><p id="err-empresa" class="cf-err mt-1 hidden text-xs font-medium text-red-700"></p></div>
      <div><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-email">Correo <span class="text-teal-deep" aria-hidden="true">*</span></label><input name="email" id="cf-email" type="email" autocomplete="email" inputmode="email" required aria-required="true" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20" /><p id="err-email" class="cf-err mt-1 hidden text-xs font-medium text-red-700"></p></div>
      <div><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-telefono">WhatsApp <span class="text-teal-deep" aria-hidden="true">*</span></label><input name="telefono" id="cf-telefono" type="tel" autocomplete="tel" inputmode="tel" required aria-required="true" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20" /><p id="err-telefono" class="cf-err mt-1 hidden text-xs font-medium text-red-700"></p></div>
      <div><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-servicio">Servicio de interés</label><select name="servicio" id="cf-servicio" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20"><option value="">Selecciona</option>{services.map((s) => <option>{s}</option>)}</select></div>
      <div><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-presupuesto">Presupuesto estimado</label><select name="presupuesto" id="cf-presupuesto" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20"><option value="">Selecciona</option>{budgets.map((b) => <option>{b}</option>)}</select></div>
    </div>
    <div class="mt-4"><label class="mb-1.5 block text-sm font-semibold text-ink" for="cf-mensaje">Cuéntanos de tu proyecto <span class="text-teal-deep" aria-hidden="true">*</span></label><textarea name="mensaje" id="cf-mensaje" rows="4" required aria-required="true" class="cf w-full rounded-xl border border-ink/12 bg-white px-4 py-3 text-sm text-ink outline-none transition placeholder:text-ink/35 focus:border-teal-deep focus:ring-2 focus:ring-teal-deep/20" placeholder="¿Qué necesitas resolver?"></textarea><p id="err-mensaje" class="cf-err mt-1 hidden text-xs font-medium text-red-700"></p></div>

    <button type="submit" data-magnetic="0.25" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-night px-6 py-4 text-sm font-semibold text-white transition-colors hover:bg-teal-deep disabled:opacity-60">Enviar solicitud</button>
    <p id="cerr" role="alert" class="mt-3 hidden text-center text-sm font-medium text-red-700"></p>
    <p class="mt-3 text-center text-xs text-ink/70">Los campos con <span aria-hidden="true">*</span><span class="sr-only">asterisco</span> son obligatorios. Tus datos solo se usan para responderte.</p>
  </form>

  <div id="cok" role="status" tabindex="-1" class="hidden flex-col items-center py-10 text-center outline-none">
    <span class="grid h-16 w-16 place-items-center rounded-full bg-teal-deep/15 text-teal-deep"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
    <h3 class="mt-5 font-display text-2xl font-bold text-ink">Solicitud recibida</h3>
    <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink/70">Gracias por escribirnos. Revisamos tu proyecto y te respondemos el mismo día hábil.</p>
  </div>
</div>

<script define:vars={{ KEY: web3formsKey, ENDPOINT: endpoint }}>
  const form = document.getElementById('cform');
  const errEl = document.getElementById('cerr');
  if (form) {
    // Plan elegido desde una tarjeta de precios: /contacto/?servicio=landing#formulario
    // Solo viaja una clave de servicio; nunca datos personales.
    const PLAN = {
      landing: 'Landing page',
      pyme: 'Diseño web / Sitio corporativo',
      ecommerce: 'Tienda online / E-commerce',
      medida: 'Software a medida',
    };
    try {
      const k = new URLSearchParams(location.search).get('servicio');
      const sel = document.getElementById('cf-servicio');
      if (k && PLAN[k] && sel) sel.value = PLAN[k];
    } catch (e) {}

    const MSG = {
      nombre: 'Escribe tu nombre.',
      empresa: 'Escribe el nombre de tu empresa o "Independiente".',
      email: 'Escribe un correo válido, por ejemplo nombre@empresa.com.',
      telefono: 'Escribe un teléfono o WhatsApp con al menos 8 dígitos.',
      mensaje: 'Cuéntanos brevemente qué necesitas.',
    };
    const clearErr = (el) => {
      el.removeAttribute('aria-invalid'); el.removeAttribute('aria-describedby');
      el.classList.remove('border-red-500');
      const p = document.getElementById('err-' + el.name); if (p) { p.textContent = ''; p.classList.add('hidden'); }
    };
    const setErr = (el, text) => {
      el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', 'err-' + el.name);
      el.classList.add('border-red-500');
      const p = document.getElementById('err-' + el.name); if (p) { p.textContent = text; p.classList.remove('hidden'); }
    };
    Object.keys(MSG).forEach((k) => {
      const el = form.elements.namedItem(k);
      el.addEventListener('input', () => clearErr(el));
      if (k === 'nombre') el.addEventListener('focus', () => { if (!window.__cfStarted) { window.__cfStarted = 1; window.dispatchEvent(new CustomEvent('cf:start')); } }, { once: true });
    });

    // Un identificador por intento: si el usuario reintenta tras un corte, el
    // backend puede reconocer que es la misma solicitud y no duplicar el lead.
    const attemptId = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + Math.random().toString(16).slice(2));
    let sending = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      const fd = new FormData(form);
      const bad = [];
      for (const k of Object.keys(MSG)) {
        const el = form.elements.namedItem(k);
        const val = String(fd.get(k) || '').trim();
        const invalid = !val
          || (k === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val))
          || (k === 'telefono' && val.replace(/\D/g, '').length < 8);
        clearErr(el);
        if (invalid) { setErr(el, MSG[k]); bad.push(k); }
      }
      if (bad.length) {
        window.dispatchEvent(new CustomEvent('cf:error', { detail: { fields: bad } }));
        errEl.textContent = bad.length === 1 ? 'Revisa el campo marcado.' : 'Revisa los ' + bad.length + ' campos marcados.';
        errEl.classList.remove('hidden');
        form.elements.namedItem(bad[0]).focus();
        return;
      }
      errEl.classList.add('hidden');
      const btn = form.querySelector('button[type="submit"]');
      const label = btn.textContent;
      const fail = (msg) => { errEl.textContent = msg; errEl.classList.remove('hidden'); sending = false; btn.disabled = false; btn.textContent = label; };
      const success = () => {
        form.classList.add('hidden');
        const ok = document.getElementById('cok');
        ok.classList.replace('hidden', 'flex');
        ok.focus();
      };

      // Honeypot anti-bots: si el campo oculto viene lleno, es un bot → fingimos éxito y no enviamos.
      if (String(fd.get('botcheck') || '')) { success(); return; }

      sending = true;
      btn.disabled = true;
      btn.textContent = 'Enviando…';

      // El lead entra al CRM desde n8n, no desde aqui (un sitio estatico no puede
      // guardar un secreto: lo que manda el navegador, `curl` lo repite).
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 15000);
      try {
        if (ENDPOINT) {
          // --- Backend 1: Webhook n8n (JSON) ---
          const payload = {
            nombre: String(fd.get('nombre') || '').trim(),
            empresa: String(fd.get('empresa') || '').trim(),
            email: String(fd.get('email') || '').trim(),
            telefono: String(fd.get('telefono') || '').trim(),
            servicio: String(fd.get('servicio') || '').trim(),
            presupuesto: String(fd.get('presupuesto') || '').trim(),
            mensaje: String(fd.get('mensaje') || '').trim(),
            botcheck: String(fd.get('botcheck') || ''),
            intento: attemptId,
            origen: location.origin + location.pathname,
            fecha: new Date().toISOString(),
          };
          const res = await fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload), signal: ctrl.signal });
          if (res.ok) { success(); window.dispatchEvent(new CustomEvent('cf:lead', { detail: { id: attemptId, servicio: payload.servicio } })); }
          else fail('No se pudo enviar. Intenta de nuevo o escríbenos por WhatsApp.');
        } else if (KEY) {
          // --- Backend 2: Web3Forms ---
          const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { Accept: 'application/json' }, body: fd, signal: ctrl.signal });
          const data = await res.json();
          if (data.success) { success(); window.dispatchEvent(new CustomEvent('cf:lead', { detail: { id: attemptId, servicio: String(fd.get('servicio') || '') } })); }
          else fail(data.message || 'No se pudo enviar. Intenta de nuevo o escríbenos por WhatsApp.');
        } else {
          fail('El formulario aún no está configurado. Escríbenos por WhatsApp mientras tanto.');
        }
      } catch (err) {
        fail(err && err.name === 'AbortError'
          ? 'La conexión tardó demasiado. Puedes intentar de nuevo: no se duplicará tu solicitud.'
          : 'Error de conexión. Intenta de nuevo o escríbenos por WhatsApp.');
      } finally {
        clearTimeout(timer);
      }
    });
  }
</script>
