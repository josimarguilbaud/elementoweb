---
import { site, grupos, legal, url, wa } from '../lib/site';
import SpotlightText from './SpotlightText.astro';
/* Pie monocromo (D56): las 4 primeras columnas salen de `grupos` de site.ts (las mismas del menú) y la quinta es
   Empresa. Debajo, las franjas de red interna de Miami e industrias y los legales. */
const waHref = wa('Hola, quiero cotizar un proyecto.');
/* Enlaces de red interna del pie: Miami (servicio remoto) e industrias con más prueba. */
const miamiLinks = [
  { slug: 'miami', label: 'Diseño web en Miami' },
  { slug: 'miami/diseno-web-en-miami-en-espanol', label: 'Páginas web para negocios hispanos' },
  { slug: 'blog/cuanto-cuesta-pagina-web-miami', label: 'Cuánto cuesta una web en Miami' },
];
const industryLinks = [
  { slug: 'industrias/diseno-web-abogados-panama', label: 'Abogados' },
  { slug: 'industrias/diseno-web-bienes-raices-panama', label: 'Bienes raíces' },
  { slug: 'industrias/diseno-web-turismo-hoteles-panama', label: 'Turismo y hoteles' },
  { slug: 'industrias/diseno-web-restaurantes-panama', label: 'Restaurantes' },
  { slug: 'industrias/diseno-web-clinicas-salud-panama', label: 'Clínicas' },
  { slug: 'industrias/diseno-web-constructoras-panama', label: 'Constructoras' },
  { slug: 'industrias/diseno-web-contadores-panama', label: 'Contadores' },
  { slug: 'industrias/diseno-web-logistica-transporte-panama', label: 'Logística y transporte' },
];
const enlace = 'text-sm leading-snug text-gris-texto transition-colors hover:text-negro hover:underline';
/* cierre: el bloque que vuelve a pedir la consulta (titular, texto y botón). La portada lo apaga porque termina en su
   propio formulario; las demás páginas lo conservan, ahora en negro. */
interface Props { cierre?: boolean }
const { cierre = true } = Astro.props;
---
<footer class="relative">
  {cierre && <div class="bg-negro px-6 py-20 text-center text-white">
    <h2 class="reveal mx-auto max-w-3xl font-display text-[clamp(2rem,5vw,3.6rem)] font-extrabold leading-[1.04]">¿Listo para una web que trabaje por tu negocio?</h2>
    <p class="reveal mx-auto mt-6 max-w-xl text-lg text-gris-claro">Diagnóstico sin costo. Propuesta con precio cerrado, por escrito.</p>
    <a href="/contacto/" data-magnetic="0.4" class="reveal mt-9 inline-flex min-h-12 items-center gap-3 rounded-full bg-white px-8 text-base font-semibold text-negro transition-colors hover:bg-filete">
      Empezar mi proyecto <span aria-hidden="true">→</span>
    </a>
  </div>}

  {/* Marca «linterna» antes de las columnas (D58): el wordmark de la tarjeta, casi invisible sobre el gris del pie. */}
  <div class="bg-humo px-6 pb-6 pt-14"><SpotlightText class="mx-auto max-w-7xl" /></div>
  <div class="border-t border-filete bg-humo">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-8 gap-y-10 px-6 py-14 lg:grid-cols-[1.5fr_repeat(5,1fr)]">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2.5 rounded-md"><img src="/marca/web/ficha-120.png" width="30" height="32" alt="" class="h-8 w-auto" loading="lazy" /><img src="/marca/web/wordmark.svg" width="167" height="20" alt="Elemento Web" class="h-5 w-auto" loading="lazy" /></a>
        <p class="mt-3 text-sm font-medium text-negro">Ciudad de Panamá · Miami</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-gris-texto">Agencia de marketing digital, inteligencia artificial y diseño web en Panamá.</p>
        <span class="mt-5 inline-flex items-center gap-2 rounded-full border border-filete bg-white px-3.5 py-2 text-xs font-semibold text-negro"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /><path d="M12 3 4 6v6c0 4 3.5 6.5 8 8 4.5-1.5 8-4 8-8V6l-8-3Z" /></svg> Tech Provider verificado por Meta</span>
        <!-- Aqui iban cuatro botones de redes que no llevaban a ningun lado: el
             enlace estaba vacio en las 108 paginas. Vuelven cuando haya perfiles
             confirmados, y ese dia tambien entran en sameAs de schema.ts. -->
      </div>
      {grupos.map((g) => (
        <div class="pie-col">
          <p class="pie-titulo text-sm font-semibold text-negro">{g.titulo}</p>
          <div class="mt-4 flex flex-col items-start gap-2.5">{g.columnas.flatMap((c) => c.links).map((l) => <a href={url(l.slug)} class={enlace}>{l.label}</a>)}</div>
        </div>
      ))}
      <div class="pie-col">
        <p class="pie-titulo text-sm font-semibold text-negro">Empresa</p>
        <div class="mt-4 flex flex-col items-start gap-2.5">
          <a href="/nosotros/" class={enlace}>Nosotros</a>
          <a href="/contacto/" class={enlace}>Contacto</a>
          <a href={`mailto:${site.email}`} class={`${enlace} break-all`}>{site.email}</a>
          <a href={waHref} target="_blank" rel="noopener" class={enlace}>WhatsApp {site.phone}<span class="sr-only"> (se abre en otra pestaña)</span></a>
          <a href={site.maps} target="_blank" rel="noopener" class={enlace}>{site.address.texto}<span class="sr-only"> (se abre Google Maps en otra pestaña)</span></a>
          <p class="text-sm leading-snug text-gris-texto">{site.horario.map((h) => h.texto).join(' · ')}</p>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-7xl border-t border-filete px-6 py-6">
      <p class="text-sm font-semibold text-negro">Miami · servicio remoto desde Panamá</p>
      <div class="mt-3 flex flex-wrap gap-x-7 gap-y-2.5">{miamiLinks.map((m) => <a href={url(m.slug)} class={enlace}>{m.label}</a>)}</div>
    </div>

    <div class="mx-auto max-w-7xl border-t border-filete px-6 py-6">
      <p class="text-sm font-semibold text-negro">Diseño web por industria</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-7 gap-y-2.5">
        {industryLinks.map((m) => <a href={url(m.slug)} class={enlace}>{m.label}</a>)}
        <a href="/industrias/" class="text-sm font-semibold text-negro hover:underline">Ver todas <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="mx-auto flex max-w-7xl flex-col gap-4 border-t border-filete px-6 py-7 text-sm text-gris-texto sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 {site.name}. Todos los derechos reservados.</span>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {legal.map((l) => <a href={url(l.slug)} class="transition-colors hover:text-negro hover:underline">{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>
