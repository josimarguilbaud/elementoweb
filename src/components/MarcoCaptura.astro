---
/* Captura real de un proyecto en un marco de navegador (`ew-dev` del molde) con su dominio escrito en la barra. La
   usan la cascada del héroe, el módulo de diseño web y la sección de proyectos de la portada v2. No es una maqueta:
   nunca va dentro de .pv2-maqueta ni lleva la nota «Ejemplo».
   - cap: ruta base de las variantes (`/portfolio/sanblasfull` → sanblasfull-480.webp, -800.webp…).
   - alt: obligatorio; "" explícito en las decorativas (el dominio ya va escrito en la barra).
   - prioridad: 'alta' para el LCP (eager + fetchpriority high); 'baja' para las que compiten con él (lazy + low).
   - movil: captura de celular que sirve el <picture> bajo COMPACTO (la del frente del héroe, recortada a 3:2). */
import { COMPACTO } from '../lib/portada';

interface Props {
  cap: string;
  dominio: string;
  alt: string;
  anchos?: number[];
  sizes?: string;
  prioridad?: 'alta' | 'baja';
  movil?: { srcset: [string, number][]; width: number; height: number };
  clase?: string;
}
const { cap, dominio, alt, anchos = [480, 800], sizes = '(min-width: 768px) 560px, 92vw', prioridad, movil, clase = '' } = Astro.props;
if (alt === undefined) throw new Error(`MarcoCaptura (${dominio}): falta alt; usa "" en las decorativas`);
if (!cap || !dominio) throw new Error('MarcoCaptura: faltan cap o dominio');
const srcset = anchos.map((w) => `${cap}-${w}.webp ${w}w`).join(', ');
const media = `(max-width: ${COMPACTO}px)`;
---
<figure class={`ew-dev pv2-marco ${clase}`.trim()}>
  <div class="ew-dev__browser">
    <div class="ew-dev__bar" aria-hidden="true"><i></i><i></i><i></i><span>{dominio}</span></div>
    <picture>
      {movil && <source media={media} srcset={movil.srcset.map(([s, w]) => `${s} ${w}w`).join(', ')} sizes="calc(100vw - 32px)" width={movil.width} height={movil.height} />}
      <img
        src={`${cap}-800.webp`}
        srcset={srcset}
        sizes={sizes}
        width="800"
        height="600"
        alt={alt}
        loading={prioridad === 'alta' ? 'eager' : 'lazy'}
        fetchpriority={prioridad === 'alta' ? 'high' : prioridad === 'baja' ? 'low' : undefined}
        decoding="async"
      />
    </picture>
  </div>
  {Astro.slots.has('pie') && <figcaption class="ew-dev__pie"><slot name="pie" /></figcaption>}
</figure>
