---
/* Módulo del bento de la portada v2 (servicios y marketing): H3, precio en voz de datos sin píldora, la vista (maqueta
   o captura real) recortada a 200 px, una línea de 70 caracteres o menos y los enlaces abajo. El módulo no es un
   enlace: solo sus enlaces lo son. En compacto la vista no se muestra (portada.css). */
import { url } from '../lib/site';

interface Props {
  id: string;
  nombre: string;
  slug: string;
  ir: string;
  linea: string;
  precio?: string | null;
  secundarios?: { label: string; href: string }[];
  ancho?: 2 | 'fila';
}
const { id, nombre, slug, ir, linea, precio, secundarios = [], ancho } = Astro.props;
if (!linea || linea.length > 70) throw new Error(`ModuloBento «${nombre}»: la línea tiene que tener 70 caracteres o menos`);
const clase = ['pv2-modulo', ancho === 2 && 'pv2-modulo--doble', ancho === 'fila' && 'pv2-modulo--fila'].filter(Boolean).join(' ');
---
<article class={clase} data-modulo={id}>
  <h3>{nombre}</h3>
  {precio && <p class="ew-data pv2-modulo__precio">{precio}</p>}
  <div class="pv2-modulo__vista"><slot /></div>
  <p class="pv2-modulo__linea">{linea}</p>
  <p class="pv2-modulo__enlaces">
    <a href={url(slug)}>{ir} <span aria-hidden="true">→</span></a>
    {secundarios.map((s) => <a href={s.href}>{s.label}</a>)}
  </p>
</article>
