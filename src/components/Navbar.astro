---
import { grupos, url, wa, type Grupo, type IconoGrupo } from '../lib/site';
/* Menú monocromo (D56): barra blanca fija, cuatro paneles al estilo Stripe y un acordeón en móvil, todo desde
   `grupos` de site.ts. Sin GSAP: los paneles y el menú móvil abren con transiciones CSS (global.css) y el script
   solo lleva estados, foco y teclado. Escritorio desde 1200 px (CORTE en el script y min-[1200px] en las clases).
   cotizar: destino de los dos «Empezar proyecto» (escritorio y móvil). Por defecto van a /contacto/ sin atributos
   de medición (track.ts los ubica por <header>); la portada los baja a su formulario y los mide como header/definir.
   dark: lo siguen pasando las páginas con héroe marino; la barra es blanca siempre, así que ya no cambia nada. */
interface Props { current?: string; dark?: boolean; cotizar?: { href: string; ctaLoc: string; service: string } }
const { current = '', cotizar } = Astro.props;
const cotizarHref = cotizar?.href ?? '/contacto/';
const ventas = wa('Hola, quiero hablar con ventas.');

/* Íconos de línea propios, 24×24 con trazo de 1,5 (se pintan a 20 px): un solo <path> cada uno, para no sumar
   elementos al DOM de las ~250 páginas (la portada tiene tope de 1.400). */
const iconos: Record<IconoGrupo, string> = {
  anuncio: 'M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1ZM15 9a3 3 0 0 1 0 6M18 6a7 7 0 0 1 0 12',
  chispa: 'M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18',
  agente: 'M8 8h8a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-5a3 3 0 0 1 3-3ZM12 4v4M9 13h.01M15 13h.01M9.5 16h5',
  caja: 'm12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm-8 4.5 8 4.5 8-4.5M12 12v9',
  ventana: 'M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2ZM3 9h18M7 6.5h.01M10 6.5h.01',
  codigo: 'm8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14',
  enchufe: 'M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0V8ZM12 17v4',
  libro: 'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5ZM4 19a2 2 0 0 1 2-2h13',
  brujula: 'M3 12a9 9 0 1 0 18 0 9 9 0 1 0-18 0ZM15.5 8.5l-2 5-5 2 2-5 5-2Z',
};
/* Ancho y columnas de cada panel (plan D56: 560, 560, 820 y 640 px). */
const forma: Record<Grupo['id'], string> = {
  marketing: 'w-[560px] grid-cols-2',
  ia: 'w-[560px] grid-cols-2',
  web: 'w-[820px] grid-cols-3',
  recursos: 'w-[640px] grid-cols-2',
};
---
<header id="nav" class="fixed inset-x-0 top-0 z-50 border-b border-filete bg-white">
  <nav id="navpill" aria-label="Principal" class="relative mx-auto flex h-[var(--nav-h)] max-w-7xl items-center gap-2 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2 rounded-md py-1.5 pr-2">
      <img src="/marca/web/ficha-120.png" width="26" height="28" alt="" class="h-7 w-auto" /><img src="/marca/web/wordmark.svg" width="142" height="17" alt="Elemento Web" class="h-[17px] w-auto" />
    </a>

    <div class="nav-links relative ml-4 hidden items-center min-[1200px]:flex">
      {grupos.map((g) => (
        <>
          <button type="button" data-menu={g.id} aria-expanded="false" aria-controls={`panel-${g.id}`} class="nav-trigger flex h-10 items-center gap-1.5 rounded-md px-3 text-sm font-medium text-gris-texto transition-colors hover:text-negro aria-expanded:text-negro aria-expanded:underline aria-expanded:decoration-2 aria-expanded:underline-offset-[22px]">
            {g.titulo}
          </button>
          <div id={`panel-${g.id}`} data-panel={g.id} data-open="0" inert class="absolute left-1/2 top-full z-40 pt-3">
            <div class={`menu-panel grid gap-x-8 gap-y-6 rounded-xl p-6 ${forma[g.id]}`}>
              {g.columnas.map((c) => (
                <div>
                  <div class="flex items-start gap-3">
                    <svg class="mt-0.5 h-5 w-5 shrink-0 text-negro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconos[c.icono]} /></svg>
                    <p class="text-sm font-semibold text-negro">{c.titulo}<span class="mt-0.5 block font-normal leading-snug text-gris-texto">{c.linea}</span></p>
                  </div>
                  <div class="mt-3 flex flex-col pl-8">
                    {c.links.map((l) => <a href={url(l.slug)} class="block rounded-md py-1.5 text-sm text-gris-texto transition-colors hover:text-negro hover:underline focus-visible:text-negro">{l.label}</a>)}
                  </div>
                </div>
              ))}
              <a href={url(g.destacada.slug)} class="menu-destacada group col-span-full flex items-center justify-between gap-4 rounded-xl bg-humo px-5 py-4">
                <span class="text-sm font-semibold text-negro">{g.destacada.titulo}<span class="mt-0.5 block font-normal text-gris-texto">{g.destacada.linea}</span></span>
                <span aria-hidden="true" class="text-negro transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </div>
        </>
      ))}
      <a href="/nosotros/" aria-current={current === 'nosotros' ? 'page' : undefined} class="flex h-10 items-center rounded-md px-3 text-sm font-medium text-gris-texto transition-colors hover:text-negro aria-[current=page]:text-negro">Nosotros</a>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <a href={ventas} target="_blank" rel="noopener" class="nav-ventas hidden h-10 items-center rounded-md px-3 text-sm font-medium text-negro hover:underline min-[1200px]:inline-flex">Hablar con ventas<span class="sr-only"> (se abre WhatsApp en otra pestaña)</span></a>
      <a href={cotizarHref} data-cta-loc={cotizar?.ctaLoc} data-service={cotizar?.service} class="cta-pill hidden h-10 items-center gap-2 rounded-full bg-negro px-5 text-sm font-semibold text-white transition-colors hover:bg-grafito sm:inline-flex">
        Empezar proyecto <span aria-hidden="true">→</span>
      </a>
      <button id="mnav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mnav" class="grid h-11 w-11 place-items-center rounded-md text-negro min-[1200px]:hidden">
        <span class="relative block h-3.5 w-5"><span class="mline absolute left-0 top-0 h-0.5 w-5 rounded bg-current transition-all duration-200"></span><span class="mline absolute left-0 top-1.5 h-0.5 w-5 rounded bg-current transition-all duration-200"></span><span class="mline absolute left-0 top-3 h-0.5 w-5 rounded bg-current transition-all duration-200"></span></span>
      </button>
    </div>
  </nav>
</header>

<!-- Menú móvil: acordeón por grupo con los mismos enlaces que los paneles de escritorio (sin las tarjetas). -->
<div id="mnav" role="dialog" aria-modal="true" aria-label="Menú de navegación" data-open="0" class="fixed inset-x-0 bottom-0 top-[var(--nav-h)] z-40 overflow-y-auto bg-white px-4 pb-10 sm:px-6 min-[1200px]:!hidden">
  <div class="mx-auto max-w-2xl">
    {grupos.map((g) => (
      <details data-grupo={g.id} class="border-b border-filete">
        <summary class="flex min-h-14 cursor-pointer items-center justify-between text-lg font-semibold text-negro">
          {g.titulo}
        </summary>
        <div class="grid gap-5 pb-5 sm:grid-cols-2">
          {g.columnas.map((c) => (
            <div>
              <p class="text-sm font-semibold text-gris-texto">{c.titulo}</p>
              <div class="mt-1 flex flex-col">
                {c.links.map((l) => <a href={url(l.slug)} class="flex min-h-11 items-center text-base text-negro">{l.label}</a>)}
              </div>
            </div>
          ))}
        </div>
      </details>
    ))}
    <a href="/nosotros/" class="m-suelto flex min-h-14 items-center border-b border-filete text-lg font-semibold text-negro">Nosotros</a>
    <a href={ventas} target="_blank" rel="noopener" class="mt-6 flex min-h-12 items-center justify-center rounded-full border border-negro text-base font-semibold text-negro">Hablar con ventas<span class="sr-only"> (se abre WhatsApp en otra pestaña)</span></a>
    <a href={cotizarHref} data-cta-loc={cotizar?.ctaLoc} data-service={cotizar?.service} class="m-cta mt-3 flex min-h-12 items-center justify-center gap-2 rounded-full bg-negro text-base font-semibold text-white">Empezar proyecto <span aria-hidden="true">→</span></a>
  </div>
</div>

<script>
  const CORTE = 1200;
  const ESPERA_ABRIR = 150, ESPERA_CERRAR = 180;
  const header = document.getElementById('nav')!;
  const zona = header.querySelector<HTMLElement>('.nav-links')!;
  const triggers = [...header.querySelectorAll<HTMLButtonElement>('.nav-trigger')];
  const panelDe = (k: string) => document.getElementById(`panel-${k}`)!;
  let abierto: string | null = null, porHover = false;
  let tAbrir: ReturnType<typeof setTimeout> | undefined, tCerrar: ReturnType<typeof setTimeout> | undefined;
  const parar = () => { clearTimeout(tAbrir); clearTimeout(tCerrar); };

  const setPanel = (k: string | null, hover = false) => {
    abierto = k; porHover = hover && !!k;
    for (const t of triggers) {
      const on = t.dataset.menu === k;
      t.setAttribute('aria-expanded', String(on));
      const p = panelDe(t.dataset.menu!);
      p.dataset.open = on ? '1' : '0';
      p.toggleAttribute('inert', !on);
    }
  };

  for (const t of triggers) {
    const k = t.dataset.menu!;
    t.addEventListener('click', () => {
      parar();
      // Si el ratón lo acaba de abrir, el clic lo confirma en vez de cerrarlo.
      if (abierto === k && porHover) { porHover = false; return; }
      setPanel(abierto === k ? null : k);
    });
    // Solo el ratón abre al pasar; un toque llega como click y no abre y cierra a la vez.
    t.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      parar();
      if (abierto) setPanel(k, true);
      else tAbrir = setTimeout(() => setPanel(k, true), ESPERA_ABRIR);
    });
  }
  zona.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') clearTimeout(tCerrar); });
  zona.addEventListener('pointerleave', (e) => {
    if (e.pointerType !== 'mouse') return;
    clearTimeout(tAbrir);
    if (abierto) tCerrar = setTimeout(() => setPanel(null), ESPERA_CERRAR);
  });
  // Si el foco sale del menú con Tab, el panel se cierra.
  zona.addEventListener('focusout', (e) => { if (abierto && !zona.contains(e.relatedTarget as Node | null)) setPanel(null); });

  // Menú móvil
  const mnav = document.getElementById('mnav')!;
  const toggle = document.getElementById('mnav-toggle')!;
  const lines = toggle.querySelectorAll<HTMLElement>('.mline');
  let mopen = false;
  const fuera = () => [document.querySelector('main'), document.querySelector('footer'), document.querySelector('a[href="#contenido"]')].filter(Boolean) as HTMLElement[];
  const enfocables = () => [toggle, ...mnav.querySelectorAll<HTMLElement>('summary, a[href]')].filter((el) => el.offsetParent !== null || el === toggle);
  const setMobile = (on: boolean, devolverFoco = false) => {
    mopen = on; mnav.dataset.open = on ? '1' : '0';
    toggle.setAttribute('aria-expanded', String(on));
    toggle.setAttribute('aria-label', on ? 'Cerrar menú' : 'Abrir menú');
    document.documentElement.style.overflow = on ? 'hidden' : '';
    for (const el of fuera()) el.toggleAttribute('inert', on);
    lines[0].style.cssText = on ? 'top:6px;transform:rotate(45deg)' : 'top:0';
    lines[1].style.opacity = on ? '0' : '1';
    lines[2].style.cssText = on ? 'top:6px;transform:rotate(-45deg)' : 'top:12px';
    if (on) mnav.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
    else if (devolverFoco) toggle.focus();
  };
  const cerrarMovil = (devolverFoco = false) => { if (mopen) setMobile(false, devolverFoco); };
  toggle.addEventListener('click', () => setMobile(!mopen));
  mnav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => cerrarMovil()));
  matchMedia(`(min-width: ${CORTE}px)`).addEventListener('change', (m) => { if (m.matches) cerrarMovil(); else setPanel(null); });

  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (mopen) { cerrarMovil(true); return; }
      if (abierto) { const t = triggers.find((x) => x.dataset.menu === abierto); parar(); setPanel(null); t?.focus(); }
      return;
    }
    // Con el menú móvil abierto, el Tab da la vuelta entre el botón y los enlaces del menú.
    if (e.key === 'Tab' && mopen) {
      const lista = enfocables(), i = lista.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); lista.at(-1)?.focus(); }
      else if (!e.shiftKey && (i === -1 || i === lista.length - 1)) { e.preventDefault(); lista[0].focus(); }
    }
  });
</script>
