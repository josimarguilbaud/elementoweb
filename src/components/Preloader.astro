---
/* Preloader solo para el home. Revela "ELEMENTO WEB", completa una barra
   de carga y sale deslizando hacia arriba. Bloquea el scroll mientras carga. */
---
<div id="preloader" class="fixed left-0 top-0 z-[100] h-full w-screen flex flex-col items-center justify-center bg-ink text-white">
  <div class="absolute inset-0 mesh-dark opacity-40"></div>
  <div class="sphere sphere-dark h-[420px] w-[420px] -left-24 top-10" style="background:#0f766e;opacity:.5"></div>
  <div class="sphere sphere-dark h-[360px] w-[360px] -right-16 bottom-0" style="background:#8b5cf6;opacity:.4"></div>

  <div id="pl-icon" class="relative mb-8" style="filter:drop-shadow(0 0 18px rgba(45,212,191,.45))">
    <svg width="72" height="72" viewBox="0 0 32 32" fill="none"><path d="M16 4 26.4 10V22L16 28 5.6 22V10Z" stroke="#2dd4bf" stroke-width="1.6" stroke-linejoin="round" /><path d="M16 16 5.6 10M16 16 26.4 10M16 16V28" stroke="#2dd4bf" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><circle cx="16" cy="16" r="1.6" fill="#2dd4bf" /></svg>
  </div>

  <div id="pl-words" class="relative flex flex-wrap justify-center gap-x-4 overflow-hidden px-6">
    {['Elemento', 'Web'].map((w) => (
      <span class="pl-word font-display text-[13vw] font-extrabold leading-none sm:text-7xl md:text-8xl">{w}</span>
    ))}
  </div>

  <div class="relative mt-10 flex w-[min(78vw,420px)] items-center justify-between gap-4">
    <div class="h-px flex-1 overflow-hidden bg-white/15"><div id="pl-bar" class="h-full origin-left scale-x-0 bg-gradient-to-r from-teal-deep via-teal to-violet"></div></div>
    <span id="pl-pct" class="font-body text-xs tabular-nums text-white/60">000</span>
  </div>
</div>

<script is:inline>
  // bloquea el scroll de inmediato para evitar salto durante la carga
  document.documentElement.style.overflow = 'hidden';
</script>

<script>
  import { gsap } from 'gsap';
  const root = document.getElementById('preloader');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const words = root.querySelectorAll('.pl-word');
    const bar = document.getElementById('pl-bar');
    const pct = document.getElementById('pl-pct');
    const done = () => {
      document.documentElement.style.overflow = '';
      const lenis = (window as any).__lenis;
      lenis?.scrollTo(0, { immediate: true });
      lenis?.start();
      root.remove();
    };

    if (reduce) {
      gsap.timeline({ onComplete: done }).to(root, { autoAlpha: 0, duration: 0.3, delay: 0.3 });
    } else {
      (window as any).__lenis?.stop();
      const c = { v: 0 };
      gsap.timeline({ defaults: { ease: 'power3.out' }, onComplete: done })
        .from('#pl-icon', { scale: 0.7, opacity: 0, duration: 0.7, ease: 'back.out(1.6)' }, 0)
        .from(words, { yPercent: 120, opacity: 0, duration: 0.9, stagger: 0.08 }, 0.15)
        .to(bar, { scaleX: 1, duration: 1.5, ease: 'power2.inOut' }, 0.2)
        .to(c, { v: 100, duration: 1.5, ease: 'power2.inOut', onUpdate: () => { if (pct) pct.textContent = String(Math.round(c.v)).padStart(3, '0'); } }, 0.2)
        .to(words, { yPercent: -120, opacity: 0, duration: 0.6, stagger: 0.04, ease: 'power3.in' }, '+=0.2')
        .to('#pl-icon', { scale: 0.9, opacity: 0, duration: 0.5, ease: 'power3.in' }, '<')
        .to(root, { yPercent: -100, duration: 0.9, ease: 'power4.inOut' }, '-=0.15');
    }
  }
</script>
