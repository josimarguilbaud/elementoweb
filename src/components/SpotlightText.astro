---
/* Marca «linterna» (D58), con la técnica real del wordmark de resend.com, invertida a fondo claro: la forma va casi
   invisible y, cerca del cursor, se enciende solo su contorno fino. Capas sobre la misma forma (<use>):
   - halo: contorno de 2 unidades desenfocado (17) bajo una máscara radial de radio 70 centrada en el cursor;
   - núcleo: contorno de 0,2 con un degradado radial (negro al centro, casi nada a los lados) y un brillo de dos
     desenfoques (2 y 25);
   - barrido: contorno de 0,4 con un degradado de radio 280 que solo marca el punto más cercano;
   - aberración: tres contornos rojo, azul y verde que se separan con la velocidad del cursor y desaparecen quieto.
   Las cifras son las de resend.com, por eso la forma va a unas 373 unidades de ancho. Por defecto la forma es el
   wordmark de la tarjeta (src/data/marca-wordmark.json); con `text` se usa un <text> con ese tamaño de letra.
   El JS (src/scripts/spotlight.ts) arranca cuando la franja se acerca a la pantalla. Sin JS o con «reducir
   movimiento», solo la forma tenue. En pantallas táctiles la luz recorre la forma sola mientras está a la vista. */
import marca from '../data/marca-wordmark.json';
interface Props {
  /** Texto a usar en vez del wordmark de la marca. */
  text?: string;
  /** Tamaño de letra del texto, en unidades del viewBox. */
  fontSize?: number;
  class?: string;
}
const { text, fontSize = 40, class: cls = '' } = Astro.props;
const w = text ? Math.round(text.length * fontSize * 0.56) : marca.w;
const h = text ? Math.round(fontSize * 1.05) : marca.h;
const pad = 4;
const vb = `${-pad} ${-pad} ${w + pad * 2} ${h + pad * 2}`;
const id = `ew-spot-${(text ?? 'marca').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const forma = `#${id}-forma`;
const cx = w / 2, cy = h / 2;
---
<div class={`ew-spot ${cls}`} data-spot>
  <svg viewBox={vb} width="100%" aria-hidden="true" focusable="false" class="ew-spot__base">
    <defs>
      {text
        ? <text id={`${id}-forma`} x="0" y={Math.round(fontSize * 0.8)} textLength={w} lengthAdjust="spacingAndGlyphs" font-size={fontSize}>{text}</text>
        : <path id={`${id}-forma`} d={marca.d} />}
    </defs>
    <use href={forma} />
  </svg>
  <svg viewBox={vb} width="100%" aria-hidden="true" focusable="false" class="ew-spot__luz">
    <defs>
      <radialGradient id={`${id}-brillo`} gradientUnits="userSpaceOnUse" cx={cx} cy={cy} r="70">
        <stop offset="0" stop-color="#0a0a0a" />
        <stop offset="0.1" stop-color="#0a0a0a" stop-opacity="0.5" />
        <stop offset="1" stop-color="#0a0a0a" stop-opacity="0.04" />
      </radialGradient>
      <radialGradient id={`${id}-barrido`} gradientUnits="userSpaceOnUse" cx={cx} cy={cy} r="280">
        <stop offset="0" stop-color="#0a0a0a" />
        <stop offset="0.1" stop-color="#0a0a0a" stop-opacity="0" />
      </radialGradient>
      <filter id={`${id}-f-brillo`} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="2" result="b1" />
        <feGaussianBlur in="SourceGraphic" stdDeviation="25" result="b2" />
        <feMerge><feMergeNode in="b2" /><feMergeNode in="b1" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <filter id={`${id}-f-halo`} x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur stdDeviation="17" /></filter>
      <filter id={`${id}-f-aberracion`} x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="4" /></filter>
      <mask id={`${id}-mascara`}><rect x="-120" y="-120" width={w + 240} height={h + 240} fill={`url(#${id}-brillo)`} /></mask>
    </defs>
    <g filter={`url(#${id}-f-halo)`}><use href={forma} fill="none" stroke="rgba(10,10,10,0.4)" stroke-width="2" stroke-linejoin="round" mask={`url(#${id}-mascara)`} /></g>
    <g filter={`url(#${id}-f-brillo)`}><use href={forma} fill="none" stroke={`url(#${id}-brillo)`} stroke-width="0.2" stroke-linejoin="round" /></g>
    <g filter={`url(#${id}-f-brillo)`}><use href={forma} fill="none" stroke={`url(#${id}-barrido)`} stroke-width="0.4" stroke-linejoin="round" /></g>
    <g filter={`url(#${id}-f-aberracion)`} class="ew-spot__aberracion">
      <use href={forma} fill="none" stroke="rgba(255,0,0,0.4)" stroke-width="0" mask={`url(#${id}-mascara)`} />
      <use href={forma} fill="none" stroke="rgba(0,100,255,0.4)" stroke-width="0" mask={`url(#${id}-mascara)`} />
      <use href={forma} fill="none" stroke="rgba(0,255,0,0.2)" stroke-width="0" mask={`url(#${id}-mascara)`} />
    </g>
  </svg>
</div>

<script>
  /* El efecto (menos de 1 KB) va en el bundle de la página: pedirlo con import() metía el ayudante de precarga de Vite
     en cada página y pesaba más que el efecto. Arranca recién cuando la franja se acerca a la pantalla. */
  import { montar } from '../scripts/spotlight';
  const raices = document.querySelectorAll<HTMLElement>('[data-spot]');
  if (raices.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        montar(e.target as HTMLElement);
      }
    }, { rootMargin: '300px 0px' });
    raices.forEach((r) => io.observe(r));
  }
</script>

<style>
  .ew-spot { position: relative; line-height: 0; user-select: none; }
  .ew-spot svg { display: block; height: auto; overflow: visible; }
  .ew-spot text { font-family: inherit; font-weight: 800; }
  .ew-spot__base { fill: rgba(10, 10, 10, 0.05); }
  .ew-spot__luz { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.5s ease-out; }
  .ew-spot.is-on .ew-spot__luz { opacity: 1; }
</style>
