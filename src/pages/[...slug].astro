---
import { etapaDe, SIGUIENTE } from '../lib/etapas';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import Pic from '../components/Pic.astro';
import PortadaServicio from '../components/PortadaServicio.astro';
import { pages } from '../lib/pages';
import { url, wa, site } from '../lib/site';
import { pageJsonLd, articleJsonLd, faqNode } from '../lib/schema';
import { heroFor, ogFor } from '../lib/img';
import formulario from '../data/formulario.json';
import { pageTypeOf } from '../lib/pages/kind';
/* La hoja del molde Kredit va en línea y solo en las páginas v2: una hoja importada aquí la bajarían las ~180
   páginas de esta ruta (Astro agrupa el CSS por ruta, no por componente renderizado). */
import moldeCss from '../styles/molde-kredit.css?inline';
/* Los estilos de las maquetas `foto` y `video` (IA creativa, D52), también en línea y solo donde se usan. */
import mediaCss from '../styles/ejemplo-media.css?inline';
/* El bloque `planes-tabs` (video inmobiliario, D55), en línea y solo donde se usa. */
import planesCss from '../styles/planes-tabs.css?inline';

export function getStaticPaths() {
  // El home vive en index.astro; aquí van todas las demás páginas del registro.
  return pages
    .filter((p) => p.slug !== '')
    .map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props;
const v2 = page.anatomia === 'v2';
const usaPlanes = page.blocks.some((b) => b.type === 'planes-tabs');
const usaMedia = usaPlanes || page.blocks.some((b) => b.type === 'ejemplos' && b.items.some((e) => e.tipo === 'foto' || e.tipo === 'video'));
const hero = heroFor(page, 1600, 0.7);
const intro = page.lead.slice(1);
const cta = page.cta ?? {};
const ctaText = cta.wa ?? `Hola, me interesa ${page.h1}.`;
const isBlog = page.parent?.slug === 'blog';
/* Los botones de una página de servicio conservan el servicio elegido en el formulario.
   La clave sale de PageData.serviceKey y el rótulo de src/data/formulario.json (D34). */
const formServicio = page.serviceKey ? formulario.servicios.find((s) => s.clave === page.serviceKey) : undefined;
const showcase = page.blocks.find((b) => b.type === 'showcase') as (Extract<import('../lib/types').Block, { type: 'showcase' }>) | undefined;
const contactHref = formServicio ? `/contacto/?servicio=${formServicio.clave}#formulario` : '/contacto/#formulario';
const contactLabel = (v2 ? page.cta?.boton : undefined) ?? formServicio?.botonPagina ?? (v2 ? formServicio?.titulo : undefined) ?? 'Cotizar por formulario';
/* Blog: Article + (si hay bloque faq) FAQPage, para ganar fragmentos en Google.
   El resto de páginas usa el grafo completo de pageJsonLd. */
const blogFaq = isBlog ? faqNode(page) : null;
const jsonld = isBlog
  ? [
      articleJsonLd({ title: page.title, description: page.description, slug: page.slug, date: new Date((page.date ?? '2026-01-15') + 'T12:00:00'), updated: page.updated, image: new URL(ogFor(page.slug), site.domain).href, hero }),
      ...(blogFaq ? [{ '@context': 'https://schema.org', ...blogFaq }] : []),
    ]
  : pageJsonLd(page, { localBusiness: page.slug === 'contacto' });
/* Cadena de enlaces de las páginas comerciales: servicio → precio → prueba → contacto. */
const CHAIN_SECTIONS = ['servicios', 'crecimiento', 'tecnologias', 'funcionalidades', 'marketing', 'industrias', 'miami', 'saas', 'diseno-web-panama'];
const showNext = CHAIN_SECTIONS.includes(page.slug.split('/')[0]);
/* D61: la primera tarjeta lleva a la etapa siguiente del recorrido (atraer → atender → automatizar → paquetes). */
const siguiente = SIGUIENTE[etapaDe(page.slug)];
const fechaLarga = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('es-PA', { day: 'numeric', month: 'long', year: 'numeric' });
const updatedLabel = isBlog && page.updated && page.updated !== page.date ? fechaLarga(page.updated) : null;
const dateLabel = page.date
  ? new Date(page.date + 'T12:00:00').toLocaleDateString('es-PA', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---
<Base title={page.title} description={page.description} dark image={ogFor(page.slug)} jsonld={jsonld} ogType={isBlog ? 'article' : 'website'} published={isBlog ? page.date : undefined} modified={isBlog ? page.updated : undefined} pageType={pageTypeOf(page)} service={page.anatomia === 'v2' ? page.serviceKey : undefined}>
  {v2 && <style slot="head" is:inline set:html={moldeCss}></style>}
  {usaMedia && <style slot="head" is:inline set:html={mediaCss}></style>}
  {usaPlanes && <style slot="head" is:inline set:html={planesCss}></style>}
  {v2 ? <PortadaServicio page={page} ctaText={ctaText} contactHref={contactHref} contactLabel={contactLabel} /> : (
  <!-- Portada interna monocroma (D57): la misma familia que la portada v3 y que la de las páginas v2 -->
  <section class="bg-humo pb-16 pt-[calc(var(--nav-h)+40px)] text-negro md:pb-20 md:pt-[calc(var(--nav-h)+72px)]">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div>
        <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-2 text-sm text-gris-texto">
          <a href="/" class="underline underline-offset-2 hover:text-negro">Inicio</a>
          <span aria-hidden="true">/</span>
          {page.parent && (<><a href={url(page.parent.slug)} class="underline underline-offset-2 hover:text-negro">{page.parent.label}</a><span aria-hidden="true">/</span></>)}
          <span class="text-negro">{page.breadcrumb ?? page.h1}</span>
        </nav>

        {isBlog && (page.category || dateLabel) && (
          <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
            {page.category && <span class="rounded-full border border-filete bg-white px-3 py-1 font-semibold text-negro">{page.category}</span>}
            {dateLabel && <span class="text-gris-texto">{dateLabel}</span>}
            {updatedLabel && <span class="text-gris-texto">· Actualizado el <time datetime={page.updated}>{updatedLabel}</time></span>}
            <span class="text-gris-texto">· Por <a href={url('nosotros')} rel="author" class="font-medium text-negro underline underline-offset-2">Josimar Guilbaud</a></span>
          </div>
        )}
        <h1 class="mt-5 max-w-[20ch] font-display text-[clamp(2.1rem,1.35rem+3.1vw,3.6rem)] font-extrabold leading-[1.05] tracking-[-0.025em] text-negro">{page.h1}</h1>
        <p class="rt mt-6 max-w-xl text-lg leading-relaxed text-gris-texto" set:html={page.lead[0]}></p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={contactHref} class="inline-flex min-h-12 items-center gap-2 rounded-full bg-negro px-6 text-sm font-semibold text-white transition-colors hover:bg-grafito">{contactLabel} <span aria-hidden="true">→</span></a>
          <a href={wa(ctaText)} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center gap-2 rounded-full border-[1.5px] border-negro bg-white px-6 text-sm font-semibold text-negro transition-colors hover:bg-humo">Hablar por WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a>
          {showcase && <a href="#ejemplo" class="inline-flex min-h-12 items-center gap-2 px-2 text-sm font-semibold text-negro underline underline-offset-4">{showcase.ctaLabel ?? 'Ver un ejemplo real'}</a>}
        </div>
        {page.offer && (<p class="mt-5 max-w-xl text-sm leading-relaxed text-gris-texto"><strong class="block font-semibold text-negro">{page.offer.line}</strong>{page.offer.note}</p>)}
      </div>

      <div>
        <Pic src={hero.src} alt={hero.alt} width={1600} height={1120} loading="eager" fetchpriority="high" sizes="(min-width:1024px) 46vw, 92vw" class="aspect-[10/7] w-full rounded-2xl object-cover" />
      </div>
    </div>
  </section>
  )}

  <!-- Intro (resto del lead); la anatomía v2 no lo usa: su contenido va en bloques (D21) -->
  {!v2 && intro.length > 0 && (
    <section class="rt mx-auto max-w-3xl px-6 pt-16">
      {intro.map((p) => <p class="reveal mb-5 text-xl leading-relaxed text-ink/70" set:html={p}></p>)}
    </section>
  )}

  <Blocks blocks={page.blocks} v2={page.anatomia === 'v2'} servicio={page.serviceKey} slug={page.slug} />
  {showNext && (
    <section class="mx-auto max-w-7xl px-6 pb-16" aria-labelledby="siguiente-paso">
      <div class="rounded-2xl border border-filete bg-white p-7 md:p-9">
        <h2 id="siguiente-paso" class="font-display text-xl font-bold text-negro md:text-2xl">Siguiente paso</h2>
        <ul class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <li><a href={url(siguiente.slug)} class="block rounded-xl border border-negro p-5 transition-colors hover:bg-humo"><span class="font-display font-bold text-negro">{siguiente.titulo}</span><span class="mt-1 block text-sm text-gris-texto">{siguiente.texto}</span></a></li>
          <li><a href="/precios/" class="block rounded-xl border border-filete p-5 transition-colors hover:border-negro"><span class="font-display font-bold text-negro">Precios</span><span class="mt-1 block text-sm text-gris-texto">Cuánto cuesta cada formato y qué incluye.</span></a></li>
          <li><a href="/casos-de-exito/" class="block rounded-xl border border-filete p-5 transition-colors hover:border-negro"><span class="font-display font-bold text-negro">Casos de éxito</span><span class="mt-1 block text-sm text-gris-texto">Proyectos reales: el problema y lo que construimos.</span></a></li>
          <li><a href={contactHref} class="block rounded-xl border border-filete p-5 transition-colors hover:border-negro"><span class="font-display font-bold text-negro">Pedir cotización</span><span class="mt-1 block text-sm text-gris-texto">Diagnóstico sin costo y propuesta con precio cerrado.</span></a></li>
        </ul>
      </div>
    </section>
  )}

</Base>
