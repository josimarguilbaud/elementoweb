---
/* Portada de agencia, versión corta (D50, tanda B de docs/specs/rediseno-elementoweb/PLAN-PORTADA.md): héroe con un
   proyecto real, riel de servicios y franja de cifras; respuesta citable; mapa de 6 servicios; proyectos publicados;
   proceso; industrias; preguntas; formulario. Los datos del mapa, el riel, el ItemList, las preguntas y la respuesta
   salen de src/lib/portada.ts (una sola fuente). La portada no se anima: no carga effects.ts (DESIGN.md, Motion). */
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import ContactForm from '../components/ContactForm.astro';
import CascadaProyectos from '../components/CascadaProyectos.astro';
import MarcoCaptura from '../components/MarcoCaptura.astro';
import ModuloBento from '../components/ModuloBento.astro';
import Maqueta from '../components/Maqueta.astro';
import CtaCotizar from '../components/CtaCotizar.astro';
import Ejemplo from '../components/Ejemplo.astro';
import TarjetaPrecio from '../components/TarjetaPrecio.astro';
import { site, industrias, saas, contactForm, marketing, pricing, url, wa, portfolio } from '../lib/site';
import { ogFor } from '../lib/img';
import { homeJsonLd } from '../lib/schema';
import { proyectosDeClientes } from '../lib/portafolio';
import {
  H1_PORTADA, filasMapa, itemListPortada, faqsPortada, respuestaPortada, precioDesde, aniosPortafolio, mapaOpciones, opcionDe,
  industriasDestacadas, desarrolloPortada, CODIGO_PORTADA, modulosMarketing, franjaPrecios, comparaPortada, noHacemosPortada,
} from '../lib/portada';
import precios from '../data/precios.json';
import formulario from '../data/formulario.json';
/* Las hojas del molde y de la portada van en línea solo aquí (como en [...slug].astro): el resto del sitio no las baja. */
import moldeCss from '../styles/molde-kredit.css?inline';
import pielCss from '../styles/piel-grafito.css?inline';
import portadaCss from '../styles/portada.css?inline';

const title = 'Agencia de Diseño Web en Panamá | Elemento Web';
const description = 'Agencia de diseño web en Panamá: sitios corporativos, tiendas online y landing pages, con SEO, Google Ads y WhatsApp. Pide tu cotización.';
const desde = precioDesde(precios, 'web-landing');
const bajada = `Diseño y desarrollo web premium, SEO profesional y marketing digital. ${desde.charAt(0).toUpperCase()}${desde.slice(1)}, con cotización cerrada por escrito.`;

const filas = filasMapa(precios);
const faqs = faqsPortada(precios);
const plazos = faqs.find((f) => f.q === '¿Cuánto tarda el proyecto?')?.a ?? '';
if (!plazos) throw new Error('La portada necesita la pregunta «¿Cuánto tarda el proyecto?» para la nota de plazos del proceso');
const respuesta = respuestaPortada(precios);
const jsonld = homeJsonLd(faqs, [itemListPortada(site.domain.replace(/\/$/, ''), filas)]);

const waCotizar = wa('Hola, quiero cotizar un proyecto con Elemento Web.');

const dominio = (href: string) => new URL(href).hostname.replace(/^www./, '');
const cascada = [
  { t: 'San Blas Full', cap: '/portfolio/sanblasfull' },
  { t: 'Panama International Movers', cap: '/portfolio/panamainternationalmovers-2026' },
  { t: 'Remodelaciones JG', cap: '/portfolio/remodelacionesjg' },
  { t: 'CicloFrio', cap: '/portfolio/ciclofrio' },
].map((p) => {
  const d = proyectosDeClientes(portfolio).find((x) => x.t === p.t);
  if (!d) throw new Error(`Proyecto de la cascada sin entrada de cliente en portfolio: ${p.t}`);
  return { ...p, dominio: dominio(d.href) };
});
const movilFrente = { srcset: [['/images/ejemplos/movil-sanblasfull-390.webp', 390], ['/images/ejemplos/movil-sanblasfull-780.webp', 780]] as [string, number][], width: 390, height: 260 };
const anios = aniosPortafolio(proyectosDeClientes(portfolio));

/* «Cotizar» con clave: la opción del selector del formulario se resuelve aquí; una clave sin opción rompe el build. */
const mapa = mapaOpciones(contactForm.services, formulario.servicios);
const opcion = (clave: string, loc: string) => opcionDe(mapa, clave, loc);

/* 3. Proyectos: los 4 que no están en la cascada ni en el módulo de diseño; KL Contable no se destaca. */
const nClientes = proyectosDeClientes(portfolio).length;
const casos = proyectosDeClientes(portfolio).filter((p) => p.caso);
const proyectosV2 = [
  { t: 'Max Impresiones', cap: '/portfolio/maximpresiones' },
  { t: 'La Vida es Bella', cap: '/portfolio/lavidaesbella' },
  { t: 'Panamá Worldwide Express', cap: '/portfolio/panamaworldwideexpress' },
  { t: 'Grupo Viesa', cap: '/portfolio/grupoviesa' },
].map((p) => {
  const d = proyectosDeClientes(portfolio).find((x) => x.t === p.t);
  if (!d) throw new Error(`Proyecto de la portada sin entrada de cliente en portfolio: ${p.t}`);
  return { ...p, ...d, dominio: dominio(d.href) };
});

/* 4. Industrias: 8 por evidencia con el héroe de su página; tres usan variantes propias de 40 KB o menos. */
const { destacadas, resto: industriasResto } = industriasDestacadas(industrias);
const PROPIAS: Record<string, [string, number, number]> = {
  'turismo-hoteles': ['-640', 640, 448], constructoras: ['-560', 560, 392], 'logistica-transporte': ['-560', 560, 392],
};
const fichas = destacadas.map((i) => {
  const base = `/images/hero/${i.slug.replace('industrias/', 'industrias--')}`;
  const propia = Object.entries(PROPIAS).find(([k]) => i.slug === `industrias/diseno-web-${k}-panama`);
  return propia
    ? { ...i, src: `${base}${propia[1][0]}.webp`, srcset: undefined, width: propia[1][1], height: propia[1][2] }
    : { ...i, src: `${base}-480.webp`, srcset: `${base}-480.webp 480w, ${base}-800.webp 800w`, width: 480, height: 336 };
});

/* 6. SEO: cuatro pilares. 7. Desarrollo: la lista con precios confirmados. */
const pilaresSeo = [
  { t: 'SEO técnico.', d: 'Velocidad, indexación y datos estructurados.' },
  { t: 'Contenido.', d: 'Páginas que responden lo que tu cliente busca.' },
  { t: 'SEO local.', d: 'Tu negocio visible en Google Maps.' },
  { t: 'GEO.', d: 'Respuestas que ChatGPT y Perplexity pueden citar.' },
];
const desarrollo = desarrolloPortada(precios);

/* 8. Marketing: los 6 servicios de la lista de site.ts, indexados por slug (sin precios: siguen propuestos, D23). */
const modulosMkt = modulosMarketing(marketing).map((m) => ({ ...m, id: m.slug.split('/')[1] }));

/* 10. Precios: tarjetas con «desde» (D23); la línea es la `ideal` de cada plan y la primera oración de A medida. */
const tiers = pricing.tiers;
const tarjetas = [
  { nombre: 'Landing page', desde: precioDesde(precios, 'web-landing'), linea: tiers[0].ideal, clave: 'landing', destacada: !!tiers[0].featured },
  { nombre: 'Web empresarial', desde: precioDesde(precios, 'web-empresarial'), linea: tiers[1].ideal, clave: 'pyme', destacada: !!tiers[1].featured },
  { nombre: 'Tienda online', desde: precioDesde(precios, 'web-ecommerce'), linea: tiers[2].ideal, clave: 'ecommerce', destacada: !!tiers[2].featured },
  { nombre: 'A medida', desde: precioDesde(precios, 'web-medida'), linea: pricing.custom.text.split(/(?<=\.)\s/)[0], clave: 'medida', destacada: false },
];
const franja = franjaPrecios(precios);

/* 11. Compara antes de firmar: cada fila enlaza la página que publica la práctica. */
const comparar = {
  type: 'compare' as const,
  h2: 'Compara antes de firmar',
  intro: 'Pon tu otra cotización en la columna en blanco y compara punto por punto.',
  otraCotizacion: true,
  criterios: comparaPortada().map((c) => ({ criterio: c.texto, nosotros: 'Sí.', fuente: { slug: c.ruta.replace(/^\/|\/$/g, ''), label: 'Fuente' } })),
};
const noHacemos = noHacemosPortada();

const pasos = {
  type: 'steps' as const,
  h2: 'Cuatro etapas.',
  intro: 'Cada etapa termina con algo que puedes revisar antes de seguir.',
  items: [
    { h3: 'Diagnóstico', text: 'Entendemos tu negocio y lo que quieres lograr, sin costo. <strong>Entregas:</strong> propuesta con alcance, precio y plazo por escrito.' },
    { h3: 'Diseño', text: 'Estructura y pantallas de las páginas clave. <strong>Entregas:</strong> pantallas que apruebas antes de programar.' },
    { h3: 'Desarrollo', text: 'Programamos con SEO técnico y velocidad desde el primer día. <strong>Entregas:</strong> demo en línea para revisar y pedir cambios.' },
    { h3: 'Lanzamiento', text: 'Publicamos y conectamos la medición de contactos. <strong>Entregas:</strong> web en tu dominio, accesos a tu nombre y capacitación.' },
  ],
};
---
<Base title={title} description={description} current="home" image={ogFor('')} jsonld={jsonld} dark pageType="home" efectos={false} cierre={false} navCotizar={{ href: '#formulario', ctaLoc: 'header', service: 'definir' }}>
  <style slot="head" is:inline set:html={moldeCss + pielCss + portadaCss}></style>

  <!-- 1. Héroe (grafito): H1 de S5, frase de display, bajada, botones y línea de confianza; a la derecha la cascada de
       proyectos reales; abajo el riel de los 6 servicios -->
  <section class="ew-hero ew-hero--home">
    <div class="ew-hero__grid">
      <div class="ew-hero__text">
        <h1 class="ew-hero__h1 pv2-h1--subtitulo">{H1_PORTADA}</h1>
        <p class="pv2-display">Construimos webs como software.</p>
        <p class="ew-hero__lead">{bajada}</p>
        <div class="ew-hero__ctas">
          <a href="#formulario" class="ew-btn ew-btn--primary" data-cta-loc="hero" data-service="definir">Cotizar mi proyecto</a>
          <a href={waCotizar} target="_blank" rel="noopener" class="ew-btn ew-btn--ghost" data-cta-loc="hero">Hablar por WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a>
        </div>
        <a href="/nosotros/" class="pv2-confianza">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><polyline points="9 12 11 14 15 10" /></svg>
          Tech Provider verificado por Meta · Respuesta el mismo día hábil
        </a>
      </div>
      <CascadaProyectos proyectos={cascada} anios={anios} movil={movilFrente} />
    </div>
    <nav aria-label="Servicios">
      <ul class="ew-rail ew-rail--6">
        {filas.map((f) => <li><a href={`${url(f.slug)}`}>{f.nombre}</a></li>)}
      </ul>
    </nav>
  </section>

  <!-- 3. Respuesta citable con fecha -->
  <Blocks v2 blocks={[{ type: 'answer', h2: 'En pocas palabras', text: respuesta.text, fecha: respuesta.fecha }]} />

  <!-- 3. Proyectos (claro alterno): sitios de clientes en línea, casos documentados y la firma del CEO -->
  <section id="proyectos" class="pv2-sec pv2-sec--alt pv2-ancla" aria-labelledby="proyectos-h2">
    <div class="pv2-wrap">
      <h2 class="ew-h2" id="proyectos-h2">{nClientes} sitios en línea que puedes visitar hoy.</h2>
      <p class="pv2-casos"><span class="ew-data">Casos documentados</span>{casos.map((c) => <a href={url(c.caso)}>{c.t}</a>)}</p>
      <ul class="pv2-proyectos">
        {proyectosV2.map((p) => (
          <li>
            <MarcoCaptura cap={p.cap} dominio={p.dominio} alt={`Web de ${p.t}`} sizes="(min-width: 1024px) 560px, (min-width: 640px) 45vw, 92vw">
              <Fragment slot="pie"><span class="pv2-proyecto__t">{p.t}</span> <span class="ew-data">{p.tag} · {p.year}</span> <a href={p.href} target="_blank" rel="noopener">Visitar sitio<span class="sr-only"> (se abre en otra pestaña)</span> <span aria-hidden="true">↗</span></a></Fragment>
            </MarcoCaptura>
          </li>
        ))}
      </ul>
      <p class="pv2-ir"><a href="/portafolio/">Ver el portafolio <span aria-hidden="true">→</span></a></p>
      <p class="ew-firma">Josimar Guilbaud, CEO. Responde por la empresa y por cada proyecto que entregamos. <a href="/nosotros/">Quiénes somos</a></p>
      <CtaCotizar loc="prueba" servicio="definir" wa={waCotizar} />
    </div>
  </section>

  <!-- 4. Industrias (grafito): 8 por evidencia, el resto como enlaces de texto y el hub -->
  <section id="industrias" class="pv2-sec pv2-banda--grafito pv2-ancla" aria-labelledby="industrias-h2">
    <div class="pv2-wrap">
      <h2 class="ew-h2" id="industrias-h2">Diseño web por industria</h2>
      <ul class="pv2-fichas">
        {fichas.map((f) => (
          <li>
            <a class="pv2-ficha" href={url(f.slug)}>
              <img src={f.src} srcset={f.srcset} sizes={f.srcset ? '(min-width: 1024px) 270px, 45vw' : undefined} width={f.width} height={f.height} alt="" loading="lazy" decoding="async" />
              <span class="pv2-ficha__t">{f.label} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="pv2-mas">
        <p class="ew-data">Más industrias</p>
        <ul class="pv2-mas__lista">{industriasResto.map((i) => <li><a href={url(i.slug)}>{i.label}</a></li>)}</ul>
      </div>
      <p class="pv2-ir"><a href="/industrias/">Ver las {industrias.length} industrias <span aria-hidden="true">→</span></a></p>
      <CtaCotizar loc="industrias" servicio="definir" wa={waCotizar} />
    </div>
  </section>

  <!-- 5. Servicios (bento, claro alterno): los 6 servicios del ItemList, cada uno con su maqueta -->
  <section id="servicios" class="pv2-sec pv2-sec--alt pv2-ancla" aria-labelledby="servicios-h2">
    <div class="pv2-wrap">
      <h2 class="ew-h2" id="servicios-h2">Seis servicios, un solo proveedor.</h2>
      <div class="pv2-bento pv2-bento--servicios">
        {filas.map((f) => (
          <ModuloBento id={f.id} nombre={f.nombre} slug={f.slug} ir={f.ir} linea={f.linea} precio={f.precio} ancho={f.id === 'diseno-web' || f.id === 'publicidad' ? 2 : undefined}
            secundarios={[...f.secundarios.map((s) => ({ label: s.label, href: url(s.slug) })), ...(f.id === 'publicidad' || f.id === 'whatsapp' ? [{ label: 'Ver detalle ↓', href: '#marketing' }] : [])]}>
            {f.id === 'diseno-web' && (
              <div class="pv2-prueba">
                <MarcoCaptura cap="/portfolio/tramitapa" dominio="tramitapa.com" alt="Web de TramitaPa, tramitapa.com, hecha por Elemento Web" sizes="(min-width: 1280px) 560px, (min-width: 640px) 60vw, 92vw">
                  <Fragment slot="pie"><span class="ew-data">tramitapa.com · proyecto publicado</span></Fragment>
                </MarcoCaptura>
              </div>
            )}
            {f.id === 'tiendas' && (
              <Maqueta nombre="tienda" linea="ficha de producto con pago por Yappy o tarjeta">
                <div class="pv2-tienda">
                  <p class="ew-dev__bar"><i></i><i></i><i></i><span>tienda.ejemplo.com</span></p>
                  <div class="pv2-tienda__cuerpo">
                    <span class="pv2-tienda__foto"></span>
                    <div>
                      <p class="pv2-tienda__nombre">Producto de ejemplo</p>
                      <p class="pv2-tienda__ops"><span>S</span><span class="pv2-sel">M</span><span>L</span></p>
                      <p class="pv2-tienda__envio">Envío a todo Panamá</p>
                      <span class="pv2-tienda__btn">Pagar con Yappy o tarjeta</span>
                    </div>
                  </div>
                </div>
              </Maqueta>
            )}
            {f.id === 'seo' && (
              <Maqueta nombre="mapa" linea="un negocio destacado en Google Maps">
                <div class="pv2-mapa">
                  <span class="pv2-mapa__pin"></span>
                  <div class="pv2-mapa__ficha">
                    <p class="pv2-mapa__nombre">Negocio de ejemplo</p>
                    <p class="pv2-mapa__cat">Abierto · Cierra a las 6:00 p. m.</p>
                    <p class="pv2-mapa__btns"><span>Cómo llegar</span><span>Llamar</span><span>Sitio web</span></p>
                  </div>
                </div>
              </Maqueta>
            )}
            {f.id === 'publicidad' && (
              <Maqueta nombre="campanas" linea="las campañas medidas hasta la consulta">
                <table class="ew-cmp pv2-campanas">
                  <thead><tr><th scope="col">Campaña</th><th scope="col">Clics</th><th scope="col">Consultas</th></tr></thead>
                  <tbody>
                    {[1, 2, 3].map(() => <tr><th scope="row"><span class="pv2-esqueleto"></span></th><td class="ew-cell-blank" data-label="Clics"></td><td class="ew-cell-blank" data-label="Consultas"></td></tr>)}
                  </tbody>
                </table>
              </Maqueta>
            )}
            {f.id === 'whatsapp' && (
              <Maqueta nombre="whatsapp-conversacion" linea="una conversación por la API oficial">
                <Ejemplo e={{ tipo: 'whatsapp', negocio: 'Negocio de ejemplo', mensajes: [{ de: 'cliente', texto: 'Hola, ¿tienen espacio el sábado?', hora: '10:02' }, { de: 'negocio', texto: 'Hola. Sí: el sábado hay espacio a las 10:00 y a las 3:00. ¿Cuál prefieres?', hora: '10:03' }] }} />
              </Maqueta>
            )}
            {f.id === 'ia' && (
              <Maqueta nombre="asistente" linea="un asistente que responde con tu información">
                <Ejemplo e={{ tipo: 'asistente', pregunta: '¿Hacen envíos a Chiriquí?', respuesta: 'Sí. Según la política de envíos del negocio, llegan a todo Panamá en 2 a 4 días hábiles.', fuentes: ['Política de envíos', 'Preguntas frecuentes'] }} />
              </Maqueta>
            )}
          </ModuloBento>
        ))}
      </div>
      <CtaCotizar loc="servicios" servicio="definir" wa={waCotizar} />
    </div>
  </section>

  <!-- 6. SEO profesional (grafito): técnica, contenido, SEO local y GEO -->
  <section id="seo" class="pv2-sec pv2-banda--grafito pv2-ancla" aria-labelledby="seo-h2">
    <div class="pv2-wrap pv2-dos">
      <div>
        <p class="ew-data pv2-rotulo">SEO profesional</p>
        <h2 class="ew-h2" id="seo-h2">Que te encuentren en Google, en Maps y en ChatGPT.</h2>
        <p class="pv2-intro">Técnica, contenido y autoridad para aparecer en Google, Google Maps y en las respuestas de ChatGPT y Perplexity.</p>
        <ol class="pv2-pilares">
          {pilaresSeo.map((p, i) => <li><span class="pv2-pilares__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span><strong>{p.t}</strong> {p.d}</span></li>)}
        </ol>
        <p class="pv2-nota-plazo">Búsquedas competidas: de 3 a 6 meses para ver avances claros.</p>
        <CtaCotizar loc="seo" servicio="revision" opcion={opcion('revision', 'seo')} texto="Pedir revisión de mi web">
          <a href="/crecimiento/seo-posicionamiento-web-panama/" class="ew-btn ew-btn--ghost">Ver SEO</a>
        </CtaCotizar>
      </div>
      <div class="pv2-lateral">
        <Maqueta nombre="informe" linea="lo que revisamos primero en una web">
          <Ejemplo e={{ tipo: 'informe', titulo: 'Revisión SEO', sitio: 'ejemplo.com', filas: [{ k: 'Velocidad en celular', v: 'Bien', estado: 'bien' }, { k: 'Títulos y descripciones', v: 'Revisar', estado: 'ojo' }, { k: 'Ficha de Google Maps', v: 'Falta', estado: 'mal' }, { k: 'Datos estructurados', v: 'Revisar', estado: 'ojo' }], pie: 'Cada punto con su arreglo y su prioridad.' }} />
        </Maqueta>
      </div>
    </div>
  </section>

  <!-- 7. Desarrollo web a medida (claro): la lista con precios confirmados, tres paneles y los SaaS propios -->
  <section id="desarrollo" class="pv2-sec pv2-sec--surface pv2-ancla" aria-labelledby="desarrollo-h2">
    <div class="pv2-wrap pv2-dos">
      <div>
        <p class="ew-data pv2-rotulo">Desarrollo web a medida</p>
        <h2 class="ew-h2" id="desarrollo-h2">Cuando una plantilla no alcanza.</h2>
        <ul class="pv2-lista">
          {desarrollo.map((d) => <li><a href={url(d.slug)}>{d.label}</a>{d.precio && <span class="ew-data">{d.precio}</span>}</li>)}
        </ul>
        <p class="pv2-saas">{saas.length} productos de software propios en producción: {saas.map((s, i) => <>{i > 0 && (i === saas.length - 1 ? ' y ' : ', ')}<a href={url(s.slug)}>{s.label}</a></>)}.</p>
        <CtaCotizar loc="desarrollo" servicio="medida" opcion={opcion('medida', 'desarrollo')} texto="Cotizar desarrollo a medida" wa={waCotizar} />
      </div>
      <div class="pv2-paneles">
        <div class="pv2-panel">
          <Maqueta nombre="codigo" linea="el código de un sitio a medida">
            <pre class="pv2-codigo"><code>{CODIGO_PORTADA.map((linea) => <span>{linea}</span>)}</code></pre>
          </Maqueta>
        </div>
        <div class="pv2-panel pv2-panel--2">
          <Maqueta nombre="agenda" linea="reservas con depósito en línea">
            <Ejemplo e={{ tipo: 'agenda', negocio: 'Clínica de ejemplo', servicio: 'Consulta general', dias: [{ d: 'Lun 20' }, { d: 'Mar 21', sel: true }, { d: 'Mié 22' }], horas: [{ h: '9:00', libre: true }, { h: '10:30', libre: false }, { h: '11:00', libre: true, sel: true }, { h: '3:00', libre: true }], boton: 'Confirmar cita' }} />
          </Maqueta>
        </div>
        <div class="pv2-panel pv2-panel--3">
          <Maqueta nombre="pago" linea="un pago con Yappy o tarjeta">
            <div class="pv2-pago">
              <p class="pv2-pago__t">Pagar con</p>
              <p class="pv2-pago__ops"><span class="pv2-sel">Yappy</span><span>Tarjeta</span><span>Transferencia</span></p>
              <span class="pv2-pago__btn">Pagar</span>
            </div>
          </Maqueta>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Marketing digital (claro alterno): tres garantías publicadas y los 6 servicios de marketing, sin precios -->
  <section id="marketing" class="pv2-sec pv2-sec--alt pv2-ancla" aria-labelledby="marketing-h2">
    <div class="pv2-wrap">
      <div>
        <p class="ew-data pv2-rotulo">Marketing digital</p>
        <h2 class="ew-h2" id="marketing-h2">Campañas que se miden hasta la consulta.</h2>
      </div>
      <ul class="pv2-garantias">
        <li><span class="ew-sign" aria-hidden="true">+</span>La cuenta publicitaria queda a tu nombre</li>
        <li><span class="ew-sign" aria-hidden="true">+</span>Tu inversión va directo a Google y Meta</li>
        <li><span class="ew-sign" aria-hidden="true">+</span>WhatsApp por la API oficial</li>
      </ul>
      <div class="pv2-bento pv2-bento--marketing">
        {modulosMkt.map((m) => (
          <ModuloBento id={m.id} nombre={m.nombre} slug={m.slug} ir={`Ver ${m.nombre}`} linea={m.linea} ancho={m.ancho}>
            {m.maqueta === 'google' && (
              <Maqueta nombre="google" linea="un anuncio de búsqueda en Google">
                <Ejemplo e={{ tipo: 'google', consulta: 'clínica dental cerca de mí', resultados: [{ clase: 'anuncio', sitio: 'Clínica de ejemplo', url: 'ejemplo.com', titulo: 'Clínica dental en Panamá | Agenda tu cita', texto: 'Limpieza, ortodoncia y urgencias. Escríbenos por WhatsApp.' }, { clase: 'organico', sitio: 'Otro negocio de ejemplo', url: 'otro-ejemplo.com', titulo: 'Odontología general y estética', texto: 'Horarios, ubicación y servicios.' }] }} />
              </Maqueta>
            )}
            {m.maqueta === 'anuncio' && (
              <Maqueta nombre="anuncio" linea="un anuncio en Facebook e Instagram">
                <div class="pv2-anuncio">
                  <p class="pv2-anuncio__top"><span class="pv2-anuncio__av"></span><span>Negocio de ejemplo<small>Publicidad</small></span></p>
                  <div class="pv2-anuncio__arte"><p>Reserva tu cita por WhatsApp</p></div>
                  <p class="pv2-anuncio__cta"><span>Enviar mensaje</span></p>
                </div>
              </Maqueta>
            )}
            {m.maqueta === 'parrilla' && (
              <Maqueta nombre="parrilla" linea="la parrilla de publicaciones de la semana">
                <ul class="pv2-parrilla">
                  <li><span class="pv2-parrilla__c"></span><span><b>Lunes</b> Consejo del mes</span></li>
                  <li><span class="pv2-parrilla__c pv2-parrilla__c--2"></span><span><b>Miércoles</b> Detrás de cámaras</span></li>
                  <li><span class="pv2-parrilla__c pv2-parrilla__c--3"></span><span><b>Viernes</b> Novedad de la semana</span></li>
                </ul>
              </Maqueta>
            )}
            {m.maqueta === 'correo' && (
              <Maqueta nombre="correo" linea="un correo a tus clientes">
                <Ejemplo e={{ tipo: 'correo', remitente: 'Negocio de ejemplo', asunto: 'Llegaron los nuevos modelos', previa: 'Te los mostramos antes que a nadie', titular: 'Llegaron los nuevos modelos', texto: 'Pasa por la tienda o pide el tuyo por WhatsApp.', boton: 'Ver los modelos' }} />
              </Maqueta>
            )}
            {m.maqueta === 'whatsapp-plantilla' && (
              <Maqueta nombre="whatsapp-plantilla" linea="un mensaje de campaña por WhatsApp">
                <Ejemplo e={{ tipo: 'whatsapp', negocio: 'Negocio de ejemplo', mensajes: [{ de: 'negocio', texto: 'Hola, María. Llegaron los modelos de la temporada.', hora: '9:00', botones: ['Ver catálogo'] }] }} />
              </Maqueta>
            )}
            {m.maqueta === 'flujo' && (
              <Maqueta nombre="flujo" linea="una consulta que pasa sola del formulario al CRM y a WhatsApp">
                <Ejemplo e={{ tipo: 'flujo', titulo: 'Nueva consulta', pasos: [{ t: 'Formulario', d: 'La persona deja sus datos' }, { t: 'CRM', d: 'Se crea el contacto' }, { t: 'WhatsApp', d: 'Recibe la respuesta' }] }} />
              </Maqueta>
            )}
          </ModuloBento>
        ))}
      </div>
      <CtaCotizar loc="marketing" servicio="pauta" opcion={opcion('pauta', 'marketing')} texto="Cotizar marketing digital">
        <a href="/marketing/" class="pv2-enlace">Ver todo el marketing digital <span aria-hidden="true">→</span></a>
      </CtaCotizar>
    </div>
  </section>

  <!-- 9. Proceso (grafito): los pasos de hoy en cuatro etapas, plazos y su «Cotizar» -->
  <div id="proceso" class="pv2-ancla pv2-banda--grafito">
    <Blocks v2 blocks={[pasos]} />
    <div class="pv2-wrap pv2-proceso__pie">
      <p class="pv2-nota-plazo">{plazos}</p>
      <p class="pv2-ir"><a href="/como-trabajamos/">Ver cómo trabajamos <span aria-hidden="true">→</span></a></p>
      <CtaCotizar loc="proceso" servicio="definir" wa={waCotizar} />
    </div>
  </div>

  <!-- 10. Precios (claro alterno): 4 tarjetas, la franja de planes y la nota de impuestos -->
  <section id="precios" class="pv2-sec pv2-sec--alt pv2-ancla" aria-labelledby="precios-h2">
    <div class="pv2-wrap">
      <h2 class="ew-h2" id="precios-h2">Precios publicados. Sin sorpresas.</h2>
      <div class="pv2-tarjetas">
        {tarjetas.map((t) => <TarjetaPrecio nombre={t.nombre} desde={t.desde} linea={t.linea} clave={t.clave} opcion={opcion(t.clave, 'precios')} destacada={t.destacada} />)}
      </div>
      <div class="pv2-franja">
        <ul>
          {franja.map((f) => <li><span class="pv2-franja__t">{f.nombre} · {f.texto}</span><a href={url(f.slug)}>Ver detalle</a></li>)}
        </ul>
        <CtaCotizar loc="precios" servicio="mensual" opcion={opcion('mensual', 'precios')} texto="Cotizar un plan mensual" />
      </div>
      <p class="pv2-nota-precios">Precios en dólares, sin ITBMS (7%). Cotización cerrada por escrito antes de empezar. <a href="/precios/">Ver todos los precios <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 11. Compara antes de firmar (grafito): la tabla con fuentes y lo que no hacemos -->
  <div id="compara" class="pv2-ancla pv2-banda--grafito">
    <Blocks v2 blocks={[comparar]} />
    <div class="pv2-wrap pv2-compara__pie">
      <h3 class="pv2-nohacemos__h">Lo que no hacemos</h3>
      <ul class="pv2-nohacemos">
        {noHacemos.map((n) => <li><span>{n.texto}</span> <a href={n.ruta} class="ew-src">Fuente</a></li>)}
      </ul>
      <!-- Sin este «Cotizar», en compacto el tramo Precios → formulario pasa de 2.110 px (tabla + preguntas ≈ 3.200 px) -->
      <CtaCotizar loc="compara" servicio="definir" texto="Pedir mi cotización por escrito" />
    </div>
  </div>

  <!-- 12. Preguntas frecuentes (claro alterno; el mismo texto alimenta el FAQPage) -->
  <div id="preguntas" class="pv2-ancla pv2-sec--alt">
    <Blocks v2 blocks={[{ type: 'faq', h2: 'Preguntas frecuentes', items: faqs }]} />
  </div>

  <!-- 13. Contacto (grafito): el formulario en blanco y el contacto directo -->
  <section class="pv2-sec pv2-banda--grafito pv2-contacto" aria-labelledby="form-h2">
    <div class="pv2-wrap pv2-dos">
      <div>
        <h2 class="ew-h2" id="form-h2">Cuéntanos qué necesitas resolver primero.</h2>
        <ul class="ew-apoyo">
          <li><span class="ew-sign" aria-hidden="true">+</span>Te respondemos el mismo día hábil.</li>
          <li><span class="ew-sign" aria-hidden="true">+</span>El diagnóstico no tiene costo.</li>
          <li><span class="ew-sign" aria-hidden="true">+</span>La cotización llega cerrada y por escrito antes de empezar.</li>
        </ul>
        <p>¿Prefieres directo? <a href={waCotizar} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a> o <a href={`mailto:${site.email}`}>{site.email}</a>. También puedes ir a la <a href="/contacto/">página de contacto</a>.</p>
      </div>
      <div>
        <p id="pv2-servicio-elegido" class="sr-only" aria-live="polite"></p>
        <ContactForm />
      </div>
    </div>
  </section>

  <script>
    /* «Cotizar» con servicio (portada v2): deja elegida la opción del formulario (data-opcion) y la anuncia. No usa
       preventDefault ni enfoca campos: el ancla hace el salto y enfoca el contenedor, así que no emite form_start. Si el
       formulario ya se envió (#cform oculto) o el envío está en curso (botón deshabilitado), no hace nada. */
    const contenedor = document.getElementById('formulario');
    contenedor?.setAttribute('tabindex', '-1');
    const vivo = document.getElementById('pv2-servicio-elegido');
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href="#formulario"][data-opcion]') as HTMLAnchorElement | null;
      if (!a) return;
      const form = document.getElementById('cform');
      const enviar = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      const sel = document.getElementById('cf-servicio') as HTMLSelectElement | null;
      if (!form || !sel || form.classList.contains('hidden') || enviar?.disabled) return;
      sel.value = a.dataset.opcion ?? '';
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      if (vivo) vivo.textContent = `Servicio elegido: ${a.dataset.opcion}`;
    });
  </script>
</Base>
