---
/* Portada v3 (D56, docs/specs/rediseno-elementoweb/PLAN-PORTADA-V3.md): agencia de marketing digital + proyectos de IA,
   en monocromo; solo las fotos, las capturas y la escultura llevan color. Ocho secciones: héroe, díptico, bento, diseño
   web, IA, respuesta citable, preguntas y formulario. Sin precios ni sección de proyectos (reglas del dueño). Los textos
   y enlaces salen de src/lib/portada.ts. El movimiento: CSS en portada.css y GSAP diferido en src/scripts/movimiento.ts. */
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, contactForm, url, wa } from '../lib/site';
import { ogFor } from '../lib/img';
import { homeJsonLd } from '../lib/schema';
import {
  H1_PORTADA, DISPLAY_PORTADA, BAJADA_PORTADA, FRANJA_PORTADA, DIPTICO_PORTADA, BENTO_PORTADA, WEB_PORTADA, IA_PORTADA,
  filasMapa, itemListPortada, faqsPortada, respuestaPortada, mapaOpciones, opcionDe,
} from '../lib/portada';
import precios from '../data/precios.json';
import formulario from '../data/formulario.json';
/* La hoja de la portada va en línea solo aquí: el resto del sitio no la baja. */
import portadaCss from '../styles/portada.css?inline';

const title = 'Agencia de Marketing Digital e IA en Panamá | Elemento Web';
const description = 'Agencia de marketing digital e IA en Panamá: páginas web, Google y Meta Ads, WhatsApp con la API oficial, agentes de IA y automatización.';
const faqs = faqsPortada();
const respuesta = respuestaPortada();
const jsonld = homeJsonLd(faqs, [itemListPortada(site.domain.replace(/\/$/, ''), filasMapa(precios))]);
const waCotizar = wa('Hola, quiero cotizar un proyecto con Elemento Web.');

/* CTA con clave: la opción del selector del formulario se resuelve aquí; una clave sin opción rompe el build. */
const mapa = mapaOpciones(contactForm.services, formulario.servicios);
const opcionIa = opcionDe(mapa, 'ia', 'ia');
const opcionWeb = opcionDe(mapa, 'pyme', 'diseno-web');
const fechaTexto = new Date(`${respuesta.fecha}T12:00:00Z`).toLocaleDateString('es-PA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={title} description={description} current="home" image={ogFor('')} jsonld={jsonld} pageType="home" efectos={false} cierre={false} navCotizar={{ href: '#formulario', ctaLoc: 'header', service: 'definir' }}>
  <style slot="head" is:inline set:html={portadaCss}></style>

  <!-- 1. Héroe: el H1 de D50 en la etiqueta, el titular de display (un <p>, candidato a LCP), botones, escultura y franja -->
  <section id="inicio" class="pv3-hero">
    <div class="pv3-wrap pv3-hero__grid">
      <div class="pv3-hero__texto">
        <h1 class="pv3-etiqueta pv3-entra">{H1_PORTADA}</h1>
        <p class="pv3-display">{DISPLAY_PORTADA[0]} <span>{DISPLAY_PORTADA[1]}</span></p>
        <p class="pv3-bajada pv3-entra">{BAJADA_PORTADA}</p>
        <div class="pv3-botones pv3-entra">
          <a href="#formulario" class="pv3-btn pv3-btn--negro" data-cta-loc="hero" data-service="definir">Empezar proyecto <span aria-hidden="true">→</span></a>
          <a href="#soluciones" class="pv3-btn pv3-btn--contorno">Ver soluciones</a>
        </div>
      </div>
      <div class="pv3-hero__escultura" data-mov="gsap" data-efecto="parallax">
        <img class="pv3-escultura" src="/images/portada-v3/escultura-800.webp" srcset="/images/portada-v3/escultura-400.webp 400w, /images/portada-v3/escultura-800.webp 800w" sizes="(min-width: 1024px) 520px, 280px" width="800" height="800" alt="Escultura abstracta de cromo plateado" fetchpriority="high" loading="eager" decoding="async" />
      </div>
    </div>
    <nav class="pv3-wrap" aria-label="Servicios">
      <ul class="pv3-franja pv3-entra">
        {FRANJA_PORTADA.map((f) => <li><a href={url(f.slug)}>{f.label}</a></li>)}
      </ul>
    </nav>
  </section>

  <!-- 2. Recorrido (D61): atraer, atender y automatizar, 3 enlaces por paso; el del medio en negro -->
  <section id="soluciones" class="pv3-sec" aria-labelledby="soluciones-h2">
    <div class="pv3-wrap">
      <h2 id="soluciones-h2" class="pv3-h2" data-mov="gsap" data-efecto="lineas">Tres pasos para crecer con marketing digital e IA.</h2>
      <div class="pv3-diptico">
        {DIPTICO_PORTADA.map((m, i) => (
          <article class={`pv3-mitad${i === 1 ? ' pv3-mitad--negra' : ''}`} data-mov="css">
            <h3 class="pv3-mitad__t"><span class="pv3-num">{m.num}</span> {m.titulo}</h3>
            <p class="pv3-mitad__l">{m.linea}</p>
            <ul class="pv3-enlaces">
              {m.enlaces.map((e) => <li><a href={url(e.slug)}>{e.label} <span aria-hidden="true">→</span></a></li>)}
            </ul>
            <img class="pv3-foto" src={m.img.src} width={m.img.width} height={m.img.height} alt={m.img.alt} loading="lazy" decoding="async" />
          </article>
        ))}
      </div>
      <p class="pv3-cierre"><a href="#formulario" class="pv3-btn pv3-btn--negro" data-cta-loc="soluciones" data-service="definir">Empezar proyecto <span aria-hidden="true">→</span></a> <a href={url('soluciones')} class="pv3-btn pv3-btn--contorno">Ver los paquetes</a></p>
    </div>
  </section>

  <!-- 2b. Agencia (D62): qué hace una agencia de marketing digital e IA, con un enlace por servicio y la ficha de la empresa -->
  <section id="agencia" class="pv3-sec pv3-sec--corta" aria-labelledby="agencia-h2">
    <div class="pv3-wrap pv3-agencia">
      <div>
        <h2 id="agencia-h2" class="pv3-h2" data-mov="gsap" data-efecto="lineas">Qué hace una agencia de marketing digital e IA.</h2>
        <p class="pv3-lead">Elemento Web es una agencia de marketing digital e IA en Ciudad de Panamá. Trabajamos para pymes y empresas que venden por chat, por cita o por cotización: traemos al cliente, lo atendemos al momento y automatizamos el seguimiento, con todo medido hasta la consulta.</p>
        <p class="pv3-ficha">Elemento Web · Vía Grecia, PH Ventury Plaza, Ciudad de Panamá · Tech Provider verificado por Meta</p>
        <p class="pv3-cierre"><a href="#formulario" class="pv3-btn pv3-btn--negro" data-cta-loc="agencia" data-service="definir">Pedir mi plan de marketing <span aria-hidden="true">→</span></a></p>
      </div>
      <ul class="pv3-agencia__lista">
        <li><a href={url('marketing/google-ads-panama')}><b>Publicidad en Google y Meta</b><span>Campañas que se miden hasta la consulta, con la cuenta a tu nombre.</span></a></li>
        <li><a href={url('marketing/contenido-redes-sociales-panama')}><b>Contenido y redes</b><span>Publicaciones, Reels y videos con IA revisados a mano.</span></a></li>
        <li><a href={url('crecimiento/posicionamiento-en-chatgpt-e-ia-panama')}><b>SEO y posicionamiento en ChatGPT</b><span>Que te encuentren en Google y te nombren las IA.</span></a></li>
        <li><a href={url('marketing/whatsapp-marketing-masivo-panama')}><b>WhatsApp con la API oficial</b><span>Campañas y un agente de ventas que responde al momento.</span></a></li>
        <li><a href={url('marketing/automatizaciones-n8n-panama')}><b>Automatización e IA</b><span>Seguimiento automático y una IA con la información de tu empresa.</span></a></li>
        <li><a href={url('diseno-web-panama')}><b>Web y medición</b><span>La web que convierte las campañas y mide cada contacto.</span></a></li>
      </ul>
    </div>
  </section>

  <!-- 3. Bento: cómo se ve el resultado; maquetas en HTML y CSS marcadas «Ejemplo», imágenes a color -->
  <section id="servicios" class="pv3-sec pv3-sec--humo" aria-labelledby="servicios-h2">
    <div class="pv3-wrap">
      <h2 id="servicios-h2" class="pv3-h2" data-mov="gsap" data-efecto="lineas">Marketing digital e IA para tu marca, en un solo equipo.</h2>
      <div class="pv3-bento">
        {BENTO_PORTADA.map((b) => (
          <article class={`pv3-tarjeta${b.ancha ? ' pv3-tarjeta--ancha' : ''}`} data-mov="css">
            <h3 class="pv3-tarjeta__t">{b.titulo}</h3>
            <p class="pv3-tarjeta__l">{b.linea}</p>
            <div class={`pv3-maqueta pv3-mq-${b.id}`} data-maqueta={b.id} data-nosnippet aria-hidden="true" data-mov="gsap" data-efecto="armar">
              {b.id === 'publicidad' && <>
                <div class="pv3-mq-busqueda" data-pieza><span>Patrocinado · cafe-ejemplo.com</span><b>Café frío para llevar en Obarrio</b><i></i></div>
                <img data-pieza src={b.img!.src} width={b.img!.width} height={b.img!.height} alt="" loading="lazy" decoding="async" />
              </>}
              {b.id === 'seo' && <>
                <div class="pv3-mq-resultado" data-pieza><span>clinica-ejemplo.com</span><b>Clínica dental en San Francisco, Panamá</b><i></i><i></i></div>
                <div class="pv3-mq-ia" data-pieza><span>Respuesta de IA</span><i></i><i></i><em>Fuente: clinica-ejemplo.com</em></div>
              </>}
              {b.id === 'whatsapp' && <>
                <div class="pv3-mq-burbuja" data-pieza>Hola Ana, tu pedido de esta semana ya está listo. ¿Te lo enviamos mañana?</div>
                <div class="pv3-mq-burbuja pv3-mq-burbuja--yo" data-pieza>Sí, por favor</div>
                <div class="pv3-mq-boton" data-pieza>Confirmar envío</div>
              </>}
              {b.id === 'agentes' && <>
                <div class="pv3-mq-burbuja pv3-mq-burbuja--yo" data-pieza>¿Tienen cita el jueves en la tarde?</div>
                <div class="pv3-mq-burbuja" data-pieza>Sí: 3:00 o 4:30 p. m. ¿Cuál te reservo?</div>
                <div class="pv3-mq-ok" data-pieza>Cita agendada · pasó al CRM</div>
              </>}
              {b.id === 'contenido' && <img data-pieza src={b.img!.src} width={b.img!.width} height={b.img!.height} alt="" loading="lazy" decoding="async" />}
            </div>
            <p class="pv3-nota">Ejemplo · {b.nota}</p>
            <a class="pv3-tarjeta__ir" href={url(b.slug)}>Ver más<span class="sr-only"> sobre {b.titulo}</span><span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
      <p class="pv3-cierre"><a href="#formulario" class="pv3-btn pv3-btn--negro" data-cta-loc="servicios" data-service="definir">Empezar proyecto <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 4. Diseño web: la sección nueva, con capturas reales del portafolio -->
  <section id="diseno-web" class="pv3-sec" aria-labelledby="web-h2">
    <div class="pv3-wrap pv3-web">
      <div>
        <h2 id="web-h2" class="pv3-h2" data-mov="gsap" data-efecto="lineas">{WEB_PORTADA.titulo}</h2>
        <p class="pv3-lead">{WEB_PORTADA.linea}</p>
        <ul class="pv3-lista">{WEB_PORTADA.items.map((t) => <li>{t}</li>)}</ul>
        <div class="pv3-botones">
          <a href="#formulario" class="pv3-btn pv3-btn--negro" data-cta-loc="diseno-web" data-service="pyme" data-opcion={opcionWeb}>Cotizar mi web</a>
          <a href="/diseno-web-panama/" class="pv3-btn pv3-btn--contorno">Ver diseño web <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="pv3-capturas" data-mov="css">
        {WEB_PORTADA.capturas.map((c) => (
          <figure class="pv3-marco">
            <span class="pv3-marco__barra" aria-hidden="true"></span>
            <img src={`${c.cap}-800.webp`} srcset={`${c.cap}-480.webp 480w, ${c.cap}-800.webp 800w`} sizes="(min-width: 1024px) 420px, 80vw" width="800" height="600" alt={`Web de ${c.t}, hecha por Elemento Web`} loading="lazy" decoding="async" />
          </figure>
        ))}
        <figure class="pv3-movil"><img src={WEB_PORTADA.movil.src} width="390" height="844" alt={`Web de ${WEB_PORTADA.movil.t} en un celular`} loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <!-- 5. Proyectos de IA: bloque negro con el diagrama y la franja de confianza -->
  <section id="ia" class="pv3-sec" aria-labelledby="ia-h2">
    <div class="pv3-wrap">
      <div class="pv3-ia">
        <div>
          <h2 id="ia-h2" class="pv3-h2">{IA_PORTADA.titulo}</h2>
          <p class="pv3-lead">{IA_PORTADA.linea}</p>
          <a href="#formulario" class="pv3-btn pv3-btn--blanco" data-cta-loc="ia" data-service="ia" data-opcion={opcionIa}>Agendar diagnóstico <span aria-hidden="true">→</span></a>
        </div>
        <div class="pv3-diagrama" data-mov="gsap" data-efecto="trazo">
          <svg class="pv3-diagrama--h" viewBox="0 0 640 96" role="img" aria-label="Flujo: un mensaje de WhatsApp llega al agente de IA, que lo registra en el CRM y alimenta un reporte">
            {IA_PORTADA.pasos.slice(1).map((_, i) => <path class="pv3-trazo" d={`M${118 + i * 168} 48 H${172 + i * 168}`} />)}
            {IA_PORTADA.pasos.map((p, i) => <g class="pv3-nodo"><rect x={i * 168 + 4} y="22" width="114" height="52" rx="10" /><text x={i * 168 + 61} y="53">{p}</text></g>)}
          </svg>
          <svg class="pv3-diagrama--v" viewBox="0 0 220 300" aria-hidden="true">
            {IA_PORTADA.pasos.slice(1).map((_, i) => <path class="pv3-trazo" d={`M110 ${56 + i * 78} V${80 + i * 78}`} />)}
            {IA_PORTADA.pasos.map((p, i) => <g class="pv3-nodo"><rect x="40" y={i * 78 + 4} width="140" height="52" rx="10" /><text x="110" y={i * 78 + 35}>{p}</text></g>)}
          </svg>
        </div>
      </div>
      <ul class="pv3-confianza">{IA_PORTADA.confianza.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <!-- 6. Respuesta citable con fecha (GEO) -->
  <section id="resumen" class="pv3-sec pv3-sec--corta" aria-labelledby="resumen-h2">
    <div class="pv3-wrap pv3-resumen">
      <h2 id="resumen-h2" class="pv3-rotulo">En resumen</h2>
      <p class="pv3-respuesta" data-block="answer" data-fecha={respuesta.fecha} set:html={respuesta.text}></p>
      <p class="pv3-fecha">Actualizado el <time datetime={respuesta.fecha}>{fechaTexto}</time></p>
    </div>
  </section>

  <!-- 7. Preguntas: el mismo texto que el FAQPage -->
  <section id="preguntas" class="pv3-sec pv3-sec--humo" aria-labelledby="preguntas-h2">
    <div class="pv3-wrap pv3-preguntas">
      <h2 id="preguntas-h2" class="pv3-h2" data-mov="gsap" data-efecto="lineas">Preguntas frecuentes</h2>
      <div data-score="faq">
        {faqs.map((f) => (
          <details class="pv3-pregunta">
            <summary data-faq-q>{f.q}</summary>
            <p data-faq-a set:html={f.a}></p>
          </details>
        ))}
      </div>
      <p class="pv3-cierre"><a href="#formulario" class="pv3-btn pv3-btn--negro" data-cta-loc="preguntas" data-service="definir">Hacer otra pregunta <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 8. Hablemos: el formulario de contacto que ya está en producción (ServiceForm sigue sin activar, 17-oct) -->
  <section id="hablemos" class="pv3-sec pv3-hablemos" aria-labelledby="hablemos-h2">
    <div class="pv3-wrap pv3-hablemos__grid">
      <div>
        <h2 id="hablemos-h2" class="pv3-h2">Hablemos.</h2>
        <p class="pv3-lead">Cuéntanos qué quieres lograr. Respondemos el mismo día hábil.</p>
        <ul class="pv3-garantias">
          <li>El diagnóstico no tiene costo.</li>
          <li>La cotización llega cerrada y por escrito antes de empezar.</li>
        </ul>
        <a href="#formulario" class="pv3-btn pv3-btn--negro pv3-hablemos__cta" data-cta-loc="hablemos" data-service="definir">Empezar proyecto <span aria-hidden="true">↓</span></a>
        <p class="pv3-directo">¿Prefieres directo? <a href={waCotizar} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a> o <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
      <div>
        <p id="pv3-servicio-elegido" class="sr-only" aria-live="polite"></p>
        <ContactForm />
      </div>
    </div>
  </section>

  <script>
    /* CTA con servicio: deja elegida la opción del formulario (data-opcion) y la anuncia. No usa preventDefault ni enfoca
       campos: el ancla hace el salto y enfoca el contenedor, así que no emite form_start. Si el formulario ya se envió
       (#cform oculto) o el envío está en curso (botón deshabilitado), no hace nada. */
    const contenedor = document.getElementById('formulario');
    contenedor?.setAttribute('tabindex', '-1');
    const vivo = document.getElementById('pv3-servicio-elegido');
    document.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest?.('a[href="#formulario"][data-opcion]') as HTMLAnchorElement | null;
      if (!a) return;
      const form = document.getElementById('cform');
      const enviar = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
      const sel = document.getElementById('cf-servicio') as HTMLSelectElement | null;
      if (!form || !sel || form.classList.contains('hidden') || enviar?.disabled) return;
      sel.value = a.dataset.opcion ?? '';
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      if (vivo) vivo.textContent = `Servicio elegido: ${a.dataset.opcion}`;
    });
  </script>
  <script>
    import { iniciar } from '../scripts/movimiento';
    iniciar();
  </script>
</Base>
