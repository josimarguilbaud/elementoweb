---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import { site, cols, marketing, saas, pricing, industrias, url, wa, clientLogos, portfolio, portfolioCats } from '../lib/site';
import ContactForm from '../components/ContactForm.astro';
import { orgNode } from '../lib/schema';

const solutions = [
  { n: '01', t: 'Diseño Web', d: 'Sitios corporativos, tiendas y landings que proyectan la solidez de tu empresa y convierten visitas en contratos.', tags: ['Astro', 'React', 'SEO técnico', 'Panel propio'], slug: 'servicios/diseno-web-corporativo-panama' },
  { n: '02', t: 'E-commerce', d: 'Tiendas pensadas para vender en Panamá: catálogo, carrito, Yappy y pasarelas locales.', tags: ['Yappy', 'Shopify', 'Inventario', 'Envíos'], slug: 'servicios/tiendas-online-ecommerce-panama' },
  { n: '03', t: 'Marketing y Pauta', d: 'Google Ads, Meta Ads y contenido que traen clientes, no solo visitas. Fee claro; tu inversión va directo a la plataforma.', tags: ['Google Ads', 'Meta Ads', 'Reels', 'Email'], slug: 'marketing' },
  { n: '04', t: 'IA y Automatización', d: 'Chatbots entrenados con tu información y flujos con n8n que atienden y venden por ti las 24 horas.', tags: ['Chatbots IA', 'WhatsApp API', 'n8n', 'CRM'], slug: 'funcionalidades/chatbots-ia-web-chatmantis-panama' },
];
const archCards = {
  corporativo: { t: 'Diseño Web Corporativo', d: 'Para empresas que necesitan proyectar solidez: estructura clara, páginas optimizadas por servicio para Google (SEO) y panel autoadministrable.', tags: ['WordPress', 'SEO Técnico'], slug: 'servicios/diseno-web-corporativo-panama' },
  landing: { t: 'Landing Pages de Conversión', d: 'Una sola página enfocada en una acción. El destino correcto para rentabilizar tus campañas de Meta y Google Ads.', slug: 'servicios/landing-pages-alta-conversion-panama' },
  ecommerce: { t: 'E-Commerce & Yappy', d: 'Tiendas listas para vender en Panamá. Pasarelas locales, Shopify/WooCommerce y gestión de inventario.', slug: 'servicios/tiendas-online-ecommerce-panama' },
  dev: { t: 'Desarrollo a Medida (Vue / React)', d: 'Cuando la plantilla se queda corta, programamos. Portales de clientes, conexiones vía API, integraciones con ERP y sistemas de reservas complejos.', slug: 'tecnologias/desarrollo-web-a-medida-vue-react-panama' },
};
const ecoSteps = [
  { n: '01', t: 'Lead entra', d: 'Un cliente escribe por WhatsApp, tu web o Instagram.', teal: true },
  { n: '02', t: 'IA interviene', d: 'El asistente responde, califica y resuelve lo básico al instante.', teal: false },
  { n: '03', t: 'CRM agenda', d: 'Se registra el lead, se agenda la cita y se notifica a tu equipo.', teal: true },
];
const procSteps = [
  { t: 'Diagnóstico', d: 'Entendemos tu negocio y objetivo. Sin costo ni compromiso.' },
  { t: 'Diseño', d: 'Estructura y pantallas que apruebas antes de programar.' },
  { t: 'Desarrollo', d: 'SEO técnico y velocidad desde el primer día, con demo online.' },
  { t: 'Lanzamiento', d: 'Publicamos en tu dominio, medimos y capacitamos a tu equipo.' },
];
const folioCats = portfolioCats;
const folioFeatured = portfolio.find((p) => p.featured)!;
// Home: solo San Blas Full (destacado) + Remodelaciones JG + TramitaPa. El resto vive en /portafolio/.
const homeFolioDomains = ['remodelacionesjg.com', 'tramitapa.com'];
const folio = portfolio.filter((p) => !p.featured && homeFolioDomains.some((d) => p.href.includes(d)));
const indIcons = ['M12 3 4 7v5c0 4 3.5 7 8 8 4.5-1 8-4 8-8V7l-8-4Z','M3 11 12 4l9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z','M6 3v7a2 2 0 0 0 4 0V3M8 10v11M16 3c-1.5 0-2 2-2 4s0 4 2 4 2-2 2-4-.5-4-2-4Zm0 8v10','M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5','M12 5v14M5 12h14M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z','M2 20h20M4 20V8l6-4 6 4M9 20v-5h4v5M18 20v-9l3 2v7','M12 4 2 9l10 5 10-5-10-5ZM6 12v5c0 1 3 2 6 2s6-1 6-2v-5','M6 6h12l1 14H5L6 6Zm3 0a3 3 0 0 1 6 0','M4 9v6M20 9v6M7 7v10M17 7v10M7 12h10','M14 6a4 4 0 0 0-5 5l-6 6 2 2 6-6a4 4 0 0 0 5-5l-2 2-2-2 2-2Z','M12 3c3 4 5 7 5 10a5 5 0 0 1-10 0c0-3 2-6 5-10Z','M1 7h13v10H1zM14 10h4l3 3v4h-7'];
const services2 = ['Diseño web / Sitio corporativo', 'Tienda online / E-commerce', 'Landing page', 'Marketing / Pauta', 'IA / Automatización', 'Otro'];

const title = 'Agencia de Diseño Web en Panamá | Elemento Web';
const description = 'Software house en Panamá: diseño web de alto rendimiento, marketing con IA y automatización. Sitios que atraen, convierten y escalan.';

const capCols = [...cols, { title: 'Marketing y Pauta', hub: 'marketing', links: marketing }, { title: 'Nuestros SaaS', hub: 'saas', links: saas.map((s) => ({ slug: s.slug, label: s.label })) }];

const saasProducts = [
  { n: 'ChatMantis', tag: 'Omnicanalidad con IA', d: 'WhatsApp, Instagram y el chat de tu web en una bandeja, con asistentes entrenados con tu información.', c: '#2dd4bf', slug: 'saas/chatmantis' },
  { n: 'WapyCRM', tag: 'CRM de ventas', d: 'Construido alrededor de WhatsApp: embudos, seguimiento automático y cierre asistido.', c: '#8b5cf6', slug: 'saas/wapycrm' },
  { n: 'Cifrao', tag: 'Software contable', d: 'Facturación, conciliación y cuentas por cobrar para empresas en Panamá.', c: '#f59e0b', slug: 'saas/cifrao' },
];
const tools = [
  { name: 'Node.js', ic: 'node' }, { name: 'Next.js', ic: 'nextjs' }, { name: 'React', ic: 'react' },
  { name: 'Vue.js', ic: 'vue' }, { name: 'Astro', ic: 'astro' }, { name: 'Vite', ic: 'vite' },
  { name: 'TypeScript', ic: 'typescript' }, { name: 'JavaScript', ic: 'javascript' }, { name: 'Tailwind CSS', ic: 'tailwind' },
  { name: 'Laravel', ic: 'laravel' }, { name: 'PHP', ic: 'php' }, { name: 'Python', ic: 'python' },
  { name: 'PostgreSQL', ic: 'postgresql' }, { name: 'MySQL', ic: 'mysql' }, { name: 'WordPress', ic: 'wordpress' },
  { name: 'Docker', ic: 'docker' },
];
const faqs = [
  ['¿Cuánto cuesta una página web en Panamá?', 'Landing desde $550, corporativa desde $950 y e-commerce desde $1,500. Siempre con cotización cerrada antes de empezar.'],
  ['¿Mi web va a aparecer en Google?', 'Se entrega con SEO técnico completo. Posicionar términos competitivos requiere además trabajo continuo de contenido, que ofrecemos por separado.'],
  ['¿Cuánto tarda el desarrollo?', 'Una landing en 5 días hábiles; un sitio corporativo entre 2 y 3 semanas desde que recibimos tu contenido.'],
  ['¿Cómo funciona el pago?', 'En tres etapas: 50% para iniciar, 30% al aprobar el demo online y 20% para publicar en tu dominio. Tarjeta, transferencia o Yappy.'],
];
---
<Base title={title} description={description} current="home" image="/portfolio/sanblasfull.jpg" jsonld={orgNode()}>
  <Preloader />

  <!-- HERO -->
  <section class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
    <div class="absolute inset-0 mesh"></div>
    <div class="sphere h-[520px] w-[520px] -left-40 -top-24" style="background:#2dd4bf;opacity:.26"></div>
    <div class="sphere h-[440px] w-[440px] right-[-8rem] top-24" style="background:#8b5cf6;opacity:.2"></div>
    <div class="relative mx-auto grid max-w-7xl grid-cols-12 items-center gap-y-16 px-6 lg:gap-x-10">
      <div class="col-span-12 lg:col-span-6">
        <p class="reveal mb-7 inline-flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.18em] text-ink/60">
          <span class="h-2 w-2 rounded-full bg-violet"></span> Boutique de diseño y desarrollo
        </p>
        <h1 class="reveal font-display text-[clamp(2.7rem,6.6vw,5.4rem)] font-extrabold leading-[0.96] tracking-tight text-ink">Sitios web que <span class="hero-outline">redefinen</span> tu industria.</h1>
        <p class="reveal mt-7 max-w-md text-lg leading-relaxed text-ink/55">Combinamos dirección de arte impecable, interacciones inmersivas y código de alto rendimiento para crear experiencias digitales inolvidables.</p>
        <div class="reveal mt-9 flex flex-wrap items-center gap-x-7 gap-y-5">
          <a href="/contacto/" data-magnetic="0.4" class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-base font-semibold text-white shadow-xl shadow-ink/25 transition-colors hover:bg-teal-deep">Iniciar proyecto <span class="grid h-6 w-6 place-items-center rounded-full bg-white/15 text-white transition-colors group-hover:bg-teal group-hover:text-ink"><svg width="10" height="10" viewBox="0 0 8 8" fill="none"><path d="M1 7 7 1M7 1H2M7 1v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full border border-ink/12 bg-white shadow-sm"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2"><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /><path d="M12 3 4 6v6c0 4 3.5 6.5 8 8 4.5-1.5 8-4 8-8V6l-8-3Z" /></svg></span>
            <div class="text-[11px] font-bold uppercase leading-tight tracking-wider text-ink/60">Meta Verified<br />Tech Provider</div>
          </div>
        </div>
      </div>
      <div class="reveal col-span-12 lg:col-span-6">
        <div class="relative mx-auto w-full max-w-[560px]">
          <div class="relative rounded-[1.75rem] border border-white/60 bg-white/90 p-2 shadow-2xl shadow-ink/10 backdrop-blur">
            <div class="flex items-center gap-2 px-3 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span><span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span><span class="h-2.5 w-2.5 rounded-full bg-ink/15"></span>
              <div class="ml-2 flex-1 rounded-md bg-ink/[0.04] px-3 py-1 text-center text-[11px] font-medium text-ink/45">◆ high-end-experience.dev</div>
            </div>
            <div class="relative aspect-[4/3.3] overflow-hidden rounded-[1.25rem] bg-ink">
              <!-- imagen real dentro del navegador -->
              <img src="/hero/studio-hero.jpg" alt="Portafolio de un estudio de diseño web premium" width="1400" height="1050" loading="lazy" class="h-full w-full object-cover" />
              <div class="pointer-events-none absolute inset-0 rounded-[1.25rem] ring-1 ring-inset ring-white/10"></div>
            </div>
          </div>
          <div class="floaty glass absolute -right-4 -top-7 w-56 rounded-2xl p-4" style="animation-delay:-1.5s">
            <div class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-md bg-gradient-to-br from-violet to-teal-deep text-[11px] text-white">◈</span><span class="text-sm font-bold text-ink">Design Tokens</span></div>
            <div class="mt-3 flex gap-2.5"><span class="h-6 w-6 rounded-full bg-ink"></span><span class="h-6 w-6 rounded-full bg-violet"></span><span class="h-6 w-6 rounded-full" style="background:#ec4899"></span><span class="h-6 w-6 rounded-full border border-ink/10 bg-paper"></span></div>
            <div class="mt-3 rounded-lg bg-ink/[0.04] px-2.5 py-2 font-mono text-[10px] leading-relaxed text-ink/55">:root &#123; --brand: <span class="text-teal-deep">perfect</span>; &#125;</div>
          </div>
          <div class="floaty glass absolute -left-6 bottom-[9%] flex items-center gap-3 rounded-2xl p-4" style="animation-delay:-3s">
            <span class="relative grid h-12 w-12 place-items-center">
              <svg width="48" height="48" viewBox="0 0 48 48" class="-rotate-90"><circle cx="24" cy="24" r="20" fill="none" stroke="#e2e8f0" stroke-width="4" /><circle cx="24" cy="24" r="20" fill="none" stroke="#16a34a" stroke-width="4" stroke-linecap="round" stroke-dasharray="126" stroke-dashoffset="0" /></svg>
              <span class="absolute font-display text-sm font-bold text-ink">100</span>
            </span>
            <div><div class="text-sm font-bold text-ink">Performance</div><div class="text-xs text-ink/50">Core Web Vitals</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero-outline {
      color: transparent;
      -webkit-text-stroke: 2px rgba(15, 23, 42, 0.32);
      text-stroke: 2px rgba(15, 23, 42, 0.32);
    }
    @media (max-width: 640px) {
      .hero-outline { -webkit-text-stroke-width: 1.4px; text-stroke-width: 1.4px; }
    }
  </style>

  <!-- LOGOS DE CLIENTES -->
  <section class="border-y border-ink/8 bg-white py-11">
    <p class="reveal mb-8 text-center text-xs font-semibold uppercase tracking-[0.22em] text-ink/40">Empresas que confían en nosotros</p>
    <div class="marquee-mask overflow-hidden">
      <div class="marquee-track items-center" style="animation-duration:60s">
        {[...clientLogos, ...clientLogos].map((f) => (
          <img src={`/logos/${f}`} alt="Cliente de Elemento Web" width="180" height="64" loading="lazy" class="mr-14 h-12 w-auto shrink-0 opacity-65 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 md:mr-16 md:h-14" style="mix-blend-mode:multiply" />
        ))}
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="relative overflow-hidden bg-ink py-28 text-white md:py-32">
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 60% 60% at 50% 40%, rgba(45,212,191,.14), transparent 70%)"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <p class="reveal mb-6 inline-block rounded-full border border-white/15 px-4 py-1.5 text-xs font-semibold text-white/60">El problema</p>
      <h2 class="reveal font-display text-[clamp(2rem,5vw,3.6rem)] font-extrabold leading-[1.05]">La mayoría de las webs en Panamá son <span class="grad-text">folletos digitales</span>.</h2>
      <p class="reveal mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-white/60">Bonitas, pero mudas. No aparecen en Google, no responden fuera de horario y no convierten la visita en un cliente. La tuya puede ser un canal de ventas.</p>
    </div>
  </section>

  <!-- SOLUCIONES -->
  <section id="solutions" class="relative bg-paper py-28 md:py-32">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-14 px-6 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <p class="reveal mb-5 inline-block rounded-full border border-ink/10 bg-white px-4 py-1.5 text-xs font-semibold text-ink/60">Soluciones</p>
          <h2 class="reveal font-display text-[clamp(2rem,4.5vw,3.4rem)] font-extrabold leading-[1.03] text-ink">Un solo equipo para toda tu <span class="grad-text">presencia digital</span>.</h2>
          <p class="reveal mt-6 max-w-sm text-lg leading-relaxed text-ink/55">Del diseño al marketing y la automatización. Cerramos el círculo: atraemos, convertimos y medimos.</p>
        </div>
      </div>
      <div class="lg:col-span-8">
        <div class="flex flex-col gap-4">
          {solutions.map((s) => (
            <details class="group reveal overflow-hidden rounded-3xl border border-ink/10 bg-white transition-colors duration-500 open:border-transparent open:bg-ink open:text-white open:shadow-2xl open:shadow-ink/30">
              <summary class="flex cursor-pointer list-none items-center gap-5 p-7 [&::-webkit-details-marker]:hidden">
                <span class="font-display text-sm font-bold text-ink/40 transition-colors group-open:text-teal">{s.n}</span>
                <h3 class="font-display text-2xl font-bold text-ink transition-colors group-open:text-white md:text-3xl">{s.t}</h3>
                <span class="ml-auto grid h-10 w-10 shrink-0 place-items-center rounded-full border border-ink/15 transition-all duration-300 group-open:rotate-45 group-open:border-teal group-open:bg-teal group-open:text-ink"><svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg></span>
              </summary>
              <div class="px-7 pb-8"><div class="ml-[2.4rem] max-w-xl">
                <p class="text-base leading-relaxed text-white/70">{s.d}</p>
                <div class="mt-5 flex flex-wrap gap-2">{s.tags.map((t) => <span class="rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-medium text-white/80">{t}</span>)}</div>
                <a href={url(s.slug)} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-teal">Ver servicio →</a>
              </div></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PORTAFOLIO -->
  <section id="showcase" class="relative overflow-hidden bg-ink py-28 text-white md:py-32">
    <div class="absolute inset-0 mesh-dark opacity-40"></div>
    <div class="sphere sphere-dark h-[420px] w-[420px] right-[-8rem] -top-10" style="background:#6d28d9;opacity:.28"></div>
    <div class="sphere sphere-dark h-[360px] w-[360px] left-[-6rem] bottom-0" style="background:#0f766e;opacity:.32"></div>

    <div class="relative mx-auto max-w-7xl px-6">
      <div class="grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
        <div>
          <span class="reveal inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-teal"><span class="h-1.5 w-1.5 rounded-full bg-teal"></span>Nuestro trabajo</span>
          <h2 class="reveal mt-5 font-display text-[clamp(2.2rem,5vw,4rem)] font-extrabold leading-[1.02]">Diseño que <span class="grad-text">desafía lo común</span>.</h2>
        </div>
        <p class="reveal text-lg leading-relaxed text-white/55">Creamos experiencias digitales que no solo se ven increíbles: <strong class="text-white/85">convierten y escalan</strong> el negocio de nuestros clientes.</p>
      </div>

      <div class="reveal mt-12 flex justify-center">
        <div class="inline-flex flex-wrap justify-center gap-1 rounded-full border border-white/12 bg-white/[0.04] p-1.5">
          {folioCats.map((c, i) => (
            <button type="button" data-folio-filter={c.key} class={`folio-tab rounded-full px-5 py-2 text-sm font-medium transition-colors ${i === 0 ? 'bg-white text-ink' : 'text-white/60 hover:text-white'}`}>{c.label}</button>
          ))}
        </div>
      </div>
      <p class="reveal mt-6 text-center text-sm text-white/35">Proyectos reales, en vivo · haz clic para visitar cada sitio.</p>

      <article class="folio-item reveal mt-8 grid overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] lg:grid-cols-2" data-cat={folioFeatured.cat}>
        <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto">
          <img src={folioFeatured.img} alt={`Sitio web de ${folioFeatured.t}`} loading="lazy" width="1200" height="900" class="h-full w-full object-cover object-top" />
        </div>
        <div class="flex flex-col justify-center p-8 md:p-12">
          <div class="flex items-center gap-3"><span class="rounded-full bg-violet/20 px-3 py-1 text-xs font-semibold text-violet">{folioFeatured.catLabel}</span><span class="text-sm text-white/40">{folioFeatured.year}</span></div>
          <h3 class="mt-4 font-display text-3xl font-extrabold">{folioFeatured.t}</h3>
          <p class="mt-3 leading-relaxed text-white/55">{folioFeatured.desc}</p>
          <a href={folioFeatured.href} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-teal transition-colors hover:text-white">Visitar sitio en vivo <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
        {folio.map((w) => (
          <a href={w.href} target="_blank" rel="noopener" class="folio-item reveal group block overflow-hidden rounded-[1.5rem] border border-white/10 bg-white/[0.03] transition-transform duration-500 hover:-translate-y-1.5" data-cat={w.cat}>
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={w.img} alt={`Sitio web de ${w.t}`} loading="lazy" width="1200" height="900" class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105" />
              <span class="absolute right-4 top-4 rounded-full bg-black/45 px-3 py-1 text-xs font-semibold backdrop-blur">{w.tag}</span>
            </div>
            <div class="flex items-center justify-between p-6">
              <div><div class="text-xs font-medium text-teal">{w.catLabel}</div><h3 class="mt-1 font-display text-lg font-bold">{w.t}</h3></div>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/15 transition-colors group-hover:bg-teal group-hover:text-ink"><svg width="12" height="12" viewBox="0 0 8 8" fill="none"><path d="M1 7 7 1M7 1H2M7 1v5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            </div>
          </a>
        ))}
      </div>

      <div class="reveal mt-8 text-center">
        <a href="/portafolio/" data-magnetic="0.3" class="inline-flex items-center gap-2.5 rounded-full border border-white/20 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:border-teal hover:text-teal">Ver todo el portafolio <span aria-hidden="true">→</span></a>
      </div>

      <figure class="reveal relative mt-16 overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.03] p-10 md:p-16">
        <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 50% 80% at 80% 20%, rgba(139,92,246,0.18), transparent 70%)"></div>
        <div class="relative">
          <div class="mb-6 font-display text-6xl leading-none text-teal">“</div>
          <blockquote class="max-w-4xl font-display text-[clamp(1.5rem,3.4vw,2.6rem)] font-bold leading-[1.2]">Rehicieron nuestro sitio y las consultas por WhatsApp se <span class="grad-text">multiplicaron</span>. Entienden de negocio, no solo de diseño.</blockquote>
          <figcaption class="mt-8 flex items-center gap-4"><span class="grid h-12 w-12 place-items-center rounded-full bg-gradient-to-br from-teal to-violet font-bold text-ink">JD</span><div><div class="font-semibold text-white">Jhair Davis</div><div class="text-sm text-white/50">Fundador de TRAMITAPA</div></div></figcaption>
