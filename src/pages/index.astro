  */}

  <!-- PRECIOS -->
  <section id="precios" class="relative bg-paper py-28 md:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <p class="reveal mb-5 inline-block rounded-full border border-ink/10 bg-white px-4 py-1.5 text-xs font-semibold text-ink/60">Precios</p>
        <h2 class="reveal font-display text-[clamp(2rem,4.5vw,3.4rem)] font-extrabold leading-[1.03] text-ink">Precios claros, sin <span class="grad-text">sorpresas después</span>.</h2>
        <p class="reveal mt-5 text-lg text-ink/55">Cotización cerrada antes de empezar. Precios en USD, no incluyen ITBMS.</p>
      </div>
      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3">
        {pricing.tiers.map((plan) => (
          <div class={`reveal relative flex flex-col rounded-[1.75rem] p-8 ${plan.featured ? 'bg-gradient-to-b from-ink to-ink-2 text-white shadow-2xl shadow-teal-deep/25 md:-my-4 md:py-12' : 'border border-ink/10 bg-white text-ink'}`}>
            {plan.featured && <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-teal px-4 py-1 text-xs font-bold text-ink">Recomendado</span>}
            <h3 class="font-display text-xl font-bold">{plan.name}</h3>
            <div class="mt-6 flex items-end gap-1.5"><span class={`text-sm font-medium ${plan.featured ? 'text-white/50' : 'text-ink/40'}`}>desde</span><span class="font-display text-5xl font-extrabold tracking-tight">{plan.price}</span></div>
            <ul class="mt-7 flex flex-col gap-3">{plan.features.map((f) => (<li class="flex items-center gap-3 text-sm"><span class={`grid h-5 w-5 shrink-0 place-items-center rounded-full ${plan.featured ? 'bg-teal text-ink' : 'bg-teal-deep text-white'}`}><svg width="10" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4.5 3.5 7 9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></span><span class={plan.featured ? 'text-white/80' : 'text-ink/70'}>{f}</span></li>))}</ul>
            <a href="/contacto/" aria-label={`Empezar con el plan ${plan.name}`} class={`mt-8 inline-flex w-full items-center justify-center rounded-full px-6 py-3.5 text-sm font-semibold transition-colors ${plan.featured ? 'bg-teal text-ink hover:bg-white' : 'border border-ink/15 text-ink hover:border-ink/40'}`}>Empezar</a>
          </div>
        ))}
      </div>

      <!-- Franja premium: corporativo a medida -->
      <div class="reveal relative mt-6 overflow-hidden rounded-[2rem] bg-ink px-8 py-10 text-white md:px-12 md:py-12">
        <div class="absolute inset-0 mesh-dark opacity-40"></div>
        <div class="sphere sphere-dark h-[360px] w-[360px] right-[-6rem] -top-24" style="background:#8b5cf6;opacity:.35"></div>
        <div class="sphere sphere-dark h-[300px] w-[300px] left-[-5rem] bottom-[-6rem]" style="background:#0f766e;opacity:.4"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1.55fr_1fr] lg:items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.05] px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wide text-teal"><span class="h-1.5 w-1.5 rounded-full bg-teal"></span>{pricing.custom.eyebrow}</span>
            <h3 class="mt-4 font-display text-[clamp(1.7rem,3.4vw,2.6rem)] font-extrabold leading-[1.08]">Páginas web corporativas <span class="grad-text">a medida</span></h3>
            <p class="mt-4 max-w-xl leading-relaxed text-white/60">{pricing.custom.text}</p>
            <div class="mt-7 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              {pricing.custom.features.map((f) => (
                <div class="flex items-center gap-2.5 text-sm text-white/75"><span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-teal/15 text-teal"><svg width="10" height="8" viewBox="0 0 10 8" fill="none"><path d="M1 4.5 3.5 7 9 1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg></span>{f}</div>
              ))}
            </div>
          </div>
          <div class="lg:border-l lg:border-white/10 lg:pl-10">
            <div class="rounded-[1.5rem] border border-white/10 bg-white/[0.04] p-7 text-center">
              <div class="text-sm font-medium text-white/45">desde</div>
              <div class="font-display text-6xl font-extrabold leading-none">{pricing.custom.price}</div>
              <p class="mx-auto mt-3 max-w-[16rem] text-sm text-white/50">Cotización cerrada por escrito tras el diagnóstico, sin compromiso.</p>
              <a href={wa(pricing.custom.wa)} target="_blank" rel="noopener" data-magnetic="0.3" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-teal px-6 py-4 text-sm font-semibold text-ink transition-colors hover:bg-white">{pricing.custom.cta}<span class="grid h-5 w-5 place-items-center rounded-full bg-ink text-teal"><svg width="9" height="9" viewBox="0 0 8 8" fill="none"><path d="M1 7 7 1M7 1H2M7 1v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
            </div>
          </div>
        </div>
      </div>

      <p class="reveal mt-10 text-center text-sm text-ink/45" set:html={pricing.infra}></p>
    </div>
  </section>

  <!-- GARANTÍA / CONFIANZA -->
  <section class="relative bg-white py-24 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="reveal relative overflow-hidden rounded-[2.5rem] border border-ink/10 bg-paper p-10 md:p-16">
