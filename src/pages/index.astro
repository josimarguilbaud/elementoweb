---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import PricingExtras from '../components/PricingExtras.astro';
import Preloader from '../components/Preloader.astro';
import { site, cols, marketing, saas, pricing, industrias, url, wa, clientLogos, portfolio, portfolioCats, planKey } from '../lib/site';
import { ogFor } from '../lib/img';
import ContactForm from '../components/ContactForm.astro';
import { homeJsonLd } from '../lib/schema';

const solutions = [
  { n: '01', t: 'Diseño Web', d: 'Sitios corporativos, tiendas y landings que proyectan la solidez de tu empresa y convierten visitas en contratos.', tags: ['Astro', 'React', 'SEO técnico', 'Panel propio'], slug: 'servicios/diseno-web-corporativo-panama' },
  { n: '02', t: 'E-commerce', d: 'Tiendas pensadas para vender en Panamá: catálogo, carrito, Yappy y pasarelas locales.', tags: ['Yappy', 'Shopify', 'Inventario', 'Envíos'], slug: 'servicios/tiendas-online-ecommerce-panama' },
  { n: '03', t: 'Marketing y Pauta', d: 'Google Ads, Meta Ads y contenido que traen clientes, no solo visitas. Fee claro; tu inversión va directo a la plataforma.', tags: ['Google Ads', 'Meta Ads', 'Reels', 'Email'], slug: 'marketing' },
  { n: '04', t: 'IA y Automatización', d: 'Un ecosistema de IA privado para tu empresa: una base de conocimiento que responde con tu información y automatizaciones que ejecutan tareas 24/7, siempre con control humano.', tags: ['RAG privado', 'Chatbots IA', 'n8n', 'CRM'], slug: 'inteligencia-artificial-para-empresas-panama' },
];
const archCards = {
  corporativo: { t: 'Diseño Web Corporativo', d: 'Para empresas que necesitan proyectar solidez: estructura clara, páginas optimizadas por servicio para Google (SEO) y panel autoadministrable.', tags: ['WordPress', 'SEO Técnico'], slug: 'servicios/diseno-web-corporativo-panama' },
  landing: { t: 'Landing Pages de Conversión', d: 'Una sola página enfocada en una acción. El destino correcto para rentabilizar tus campañas de Meta y Google Ads.', slug: 'servicios/landing-pages-alta-conversion-panama' },
  ecommerce: { t: 'E-Commerce & Yappy', d: 'Tiendas listas para vender en Panamá. Pasarelas locales, Shopify/WooCommerce y gestión de inventario.', slug: 'servicios/tiendas-online-ecommerce-panama' },
  dev: { t: 'Desarrollo a Medida (Vue / React)', d: 'Cuando la plantilla se queda corta, programamos. Portales de clientes, conexiones vía API, integraciones con ERP y sistemas de reservas complejos.', slug: 'tecnologias/desarrollo-web-a-medida-vue-react-panama' },
};
const ecoSteps = [
  { n: '01', t: 'Lead entra', d: 'Un cliente escribe por WhatsApp, tu web o Instagram.', teal: true },
  { n: '02', t: 'IA interviene', d: 'El asistente responde, califica y resuelve lo básico al instante.', teal: false },
  { n: '03', t: 'CRM agenda', d: 'Se registra el lead, se agenda la cita y se notifica a tu equipo.', teal: true },
];
const procSteps = [
  { t: 'Diagnóstico', d: 'Entendemos tu negocio y objetivo. Sin costo ni compromiso.' },
  { t: 'Diseño', d: 'Estructura y pantallas que apruebas antes de programar.' },
  { t: 'Desarrollo', d: 'SEO técnico y velocidad desde el primer día, con demo online.' },
  { t: 'Lanzamiento', d: 'Publicamos en tu dominio, medimos y capacitamos a tu equipo.' },
];
const folioCats = portfolioCats;
const folioFeatured = portfolio.find((p) => p.featured)!;
// Home: San Blas Full (destacado) + Remodelaciones JG + TramitaPa + Panama International Movers + CicloFrio. El resto vive en /portafolio/.
const homeFolioDomains = ['remodelacionesjg.com', 'tramitapa.com', 'panamainternationalmovers.com', 'ciclofrio.com'];
const folio = portfolio.filter((p) => !p.featured && homeFolioDomains.some((d) => p.href.includes(d)));
const folioItems = [folioFeatured, ...folio];
const indIcons = ['M12 3 4 7v5c0 4 3.5 7 8 8 4.5-1 8-4 8-8V7l-8-4Z','M3 11 12 4l9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z','M6 3v7a2 2 0 0 0 4 0V3M8 10v11M16 3c-1.5 0-2 2-2 4s0 4 2 4 2-2 2-4-.5-4-2-4Zm0 8v10','M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5','M12 5v14M5 12h14M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z','M2 20h20M4 20V8l6-4 6 4M9 20v-5h4v5M18 20v-9l3 2v7','M12 4 2 9l10 5 10-5-10-5ZM6 12v5c0 1 3 2 6 2s6-1 6-2v-5','M6 6h12l1 14H5L6 6Zm3 0a3 3 0 0 1 6 0','M4 9v6M20 9v6M7 7v10M17 7v10M7 12h10','M14 6a4 4 0 0 0-5 5l-6 6 2 2 6-6a4 4 0 0 0 5-5l-2 2-2-2 2-2Z','M12 3c3 4 5 7 5 10a5 5 0 0 1-10 0c0-3 2-6 5-10Z','M1 7h13v10H1zM14 10h4l3 3v4h-7'];
const services2 = ['Diseño web / Sitio corporativo', 'Tienda online / E-commerce', 'Landing page', 'Marketing / Pauta', 'IA / Automatización', 'Otro'];

/* WhatsApp del CTA que va debajo del portafolio. */
const waHome = wa('Hola, vi su portafolio y quiero un diagnóstico para mi proyecto.');

const title = 'Agencia de Diseño Web en Panamá | Elemento Web';
const description = 'Agencia de diseño web en Panamá. Páginas corporativas, tiendas online y landing pages con diseño a medida y SEO técnico. Solicita tu cotización.';

const capCols = [...cols, { title: 'Marketing y Pauta', hub: 'marketing', links: marketing }, { title: 'Nuestros SaaS', hub: 'saas', links: saas.map((s) => ({ slug: s.slug, label: s.label })) }];

const saasProducts = [
  { n: 'WazaCRM', tag: 'CRM de WhatsApp con IA', d: 'Atiende, cotiza, agenda y cobra dentro del chat, con embudo de ventas y bandeja compartida detrás.', c: '#0099cc', slug: 'saas/wazacrm' },
  { n: 'NousCRM', tag: 'Cotizaciones y cobros', d: 'Cotiza, factura y cobra por WhatsApp: tu cliente abre todo sin crear cuenta.', c: '#5ec8e8', slug: 'saas/nouscrm' },
  { n: 'Cifrao', tag: 'Software contable', d: 'Facturación, conciliación y cuentas por cobrar para empresas en Panamá.', c: '#f59e0b', slug: 'saas/cifrao' },
];
const tools = [
  { name: 'Node.js', ic: 'node' }, { name: 'Next.js', ic: 'nextjs' }, { name: 'React', ic: 'react' },
  { name: 'Vue.js', ic: 'vue' }, { name: 'Astro', ic: 'astro' }, { name: 'Vite', ic: 'vite' },
  { name: 'TypeScript', ic: 'typescript' }, { name: 'JavaScript', ic: 'javascript' }, { name: 'Tailwind CSS', ic: 'tailwind' },
  { name: 'Laravel', ic: 'laravel' }, { name: 'PHP', ic: 'php' }, { name: 'Python', ic: 'python' },
  { name: 'PostgreSQL', ic: 'postgresql' }, { name: 'MySQL', ic: 'mysql' }, { name: 'WordPress', ic: 'wordpress' },
  { name: 'Docker', ic: 'docker' },
];
/* Estas cuatro preguntas se pintan en la portada Y alimentan el FAQPage del
   JSON-LD (ver homeJsonLd). Son las que mas se buscan en el mercado, asi que
   conviene que un motor generativo pueda citarlas textualmente. */
const ctaLabel = (n: string) => ({ landing: 'Cotizar mi landing', pyme: 'Cotizar mi web', ecommerce: 'Cotizar mi tienda' } as Record<string, string>)[planKey(n)] || 'Cotizar mi proyecto';
const faqs: [string, string][] = [
  ['¿Cuánto cuesta una página web en Panamá?', 'Landing desde $550, corporativa desde $1,250 y e-commerce desde $1,950. Siempre con cotización cerrada antes de empezar.'],
  ['¿Mi web va a aparecer en Google?', 'Se entrega con SEO técnico completo. Posicionar términos competitivos requiere además trabajo continuo de contenido, que ofrecemos por separado.'],
  ['¿Cuánto tarda el desarrollo?', 'Una landing en 5 días hábiles; un sitio corporativo entre 2 y 3 semanas desde que recibimos tu contenido.'],
  ['¿Cómo funciona el pago?', 'Hay dos modalidades. Proyecto por etapas: 50% para iniciar, 30% al aprobar el demo online y 20% para publicar en tu dominio. Plan mensual gestionado: $350 de puesta en marcha más $169 al mes durante 12 meses, y desde el mes 13 solo $94 al mes por el servicio continuo. Tarjeta, transferencia o Yappy.'],
  ['¿En el plan mensual, la web es mía?', 'Sí. Dominio, hosting y accesos quedan a nombre de tu empresa. Si decides no continuar tras el mes 12, te entregamos la web y sus accesos; el detalle de cancelación se acuerda por escrito antes de empezar.'],
];
---
<Base title={title} description={description} current="home" image={ogFor('')} jsonld={homeJsonLd(faqs)}>
  <Preloader />

  <!-- HERO -->
  <!-- Hero compacto: antes el titular llegaba a 6.5rem y empujaba los botones
       debajo del pliegue en un portatil de 900px de alto. Se baja el techo del
       clamp y se aprietan los margenes para que el CTA se vea sin hacer scroll. -->
  <section class="relative flex items-center overflow-hidden pt-24 pb-12 md:pt-28 md:pb-16">
    <div class="absolute inset-0 mesh"></div>
    <div id="hero-glow" class="pointer-events-none absolute inset-0"></div>
    <div class="relative mx-auto flex max-w-5xl flex-col items-center px-6 text-center">
      <p class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-ink/10 bg-white/70 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-ink/70 shadow-sm backdrop-blur md:mb-7">
        <span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet opacity-70"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-violet"></span></span>
        Boutique de diseño y desarrollo
      </p>
      <h1 class="font-display text-[clamp(2.4rem,6.2vw,4.5rem)] font-extrabold leading-[1.05] tracking-tight text-ink">Diseño web en Panamá <br class="hidden sm:block" />que <span class="hero-outline italic pr-1">convierte</span> visitas en consultas.</h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink/70 md:text-lg">Somos una agencia de <strong class="font-semibold text-ink/80">diseño web en Panamá</strong>. Creamos páginas corporativas, tiendas online y landing pages con diseño a medida, SEO técnico y precio cerrado.</p>
      <div class="mt-8 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-5">
        <a href="/contacto/#formulario" data-magnetic="0.35" class="group relative inline-flex w-full items-center justify-center gap-3 overflow-hidden rounded-full bg-night px-8 py-3.5 text-base font-semibold text-white shadow-xl shadow-ink/25 transition-all hover:-translate-y-0.5 hover:bg-teal-deep sm:w-auto">
          <span class="relative z-10">Cotizar mi página web</span>
          <svg class="relative z-10 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="19" x2="19" y2="5" /><polyline points="5 5 19 5 19 19" /></svg>
        </a>
        <span class="hidden text-sm text-ink/70 sm:block">o</span>
        <a href="/portafolio/" class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-ink/15 bg-white px-8 py-3.5 text-base font-semibold text-ink transition-all hover:border-ink/35 hover:shadow-md sm:w-auto">Ver proyectos reales</a>
      </div>
      <nav aria-label="Elige tu mercado" class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm">
        <span class="text-ink/70">Trabajamos en:</span>
        <a href="/diseno-web-panama/" class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-4 py-2 font-semibold text-ink transition hover:border-ink/35 hover:shadow-sm"><span class="grid h-5 w-5 place-items-center rounded-full bg-night text-[9px] font-bold text-white" aria-hidden="true">PA</span>Panamá <span class="font-normal text-ink/70">· sede</span></a>
        <a href="/miami/" class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-4 py-2 font-semibold text-ink transition hover:border-ink/35 hover:shadow-sm"><span class="grid h-5 w-5 place-items-center rounded-full bg-teal-deep text-[9px] font-bold text-white" aria-hidden="true">US</span>Miami <span class="font-normal text-ink/70">· remoto, en español</span></a>
      </nav>
      <div class="mt-9 flex items-center justify-center gap-3 rounded-2xl border border-ink/10 bg-white/60 px-5 py-2.5 shadow-sm backdrop-blur">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-teal-deep/10 text-teal-deep"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><polyline points="9 12 11 14 15 10" /></svg></span>
        <div class="text-left"><p class="text-[10px] font-black uppercase leading-none tracking-widest text-ink/70">Meta Verified</p><p class="mt-1 text-sm font-bold leading-none text-ink/75">Tech Provider</p></div>
      </div>
    </div>
  </section>

  <style>
    .hero-outline {
      color: transparent;
      -webkit-text-stroke: 2px rgba(51, 51, 51, 0.85);
      text-stroke: 2px rgba(51, 51, 51, 0.85);
    }
    @media (max-width: 640px) {
      .hero-outline { -webkit-text-stroke-width: 1.4px; text-stroke-width: 1.4px; }
    }
    /* Brillo que sigue al cursor sobre la grilla del hero */
    #hero-glow {
      background:
        radial-gradient(circle 600px at var(--mx, 32%) var(--my, 28%), rgba(0, 153, 204, 0.10), transparent 70%),
        radial-gradient(circle 720px at calc(100% - var(--mx, 32%)) calc(100% - var(--my, 28%)), rgba(94, 200, 232, 0.09), transparent 72%);
      transition: background 0.3s ease-out;
    }
  </style>

  <script>
    const glow = document.getElementById('hero-glow');
    const fine = matchMedia('(hover:hover) and (pointer:fine)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (glow && fine && !reduce) {
      let raf: number | undefined;
      addEventListener('mousemove', (e) => {
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          glow.style.setProperty('--mx', (e.clientX / innerWidth) * 100 + '%');
          glow.style.setProperty('--my', (e.clientY / innerHeight) * 100 + '%');
        });
      }, { passive: true });
    }
  </script>

  <!-- LOGOS DE CLIENTES -->
  <section class="border-y border-ink/8 bg-white py-11">
    <p class="reveal mb-8 text-center text-xs font-semibold uppercase tracking-[0.22em] text-ink/70">Empresas que confían en nosotros</p>
    <div class="marquee-mask overflow-hidden">
      <div class="marquee-track items-center" style="animation-duration:60s">
        {/* alt vacio a proposito: son 52 imagenes (la tira va duplicada para el
            bucle) y no tenemos el nombre de cada empresa. Repetir "Cliente de
            Elemento Web" 52 veces le hace perder el tiempo a quien usa lector
            de pantalla y no aporta nada; el rotulo de la seccion ya dice que
            son. Cuando se sepan los nombres, cada logo lleva el suyo. */}
        {[...clientLogos, ...clientLogos].map((f) => (
          <img src={`/logos/${f}`} alt="" width="180" height="64" loading="lazy" class="mr-14 h-12 w-auto shrink-0 opacity-65 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 md:mr-16 md:h-14" style="mix-blend-mode:multiply" />
        ))}
      </div>
    </div>
  </section>

  <!-- PORTAFOLIO -->
  <section id="showcase" class="relative overflow-hidden bg-[#0a1118] py-28 text-white md:py-32">
    <div class="absolute inset-0 mesh-dark opacity-40"></div>
    <div class="sphere sphere-dark h-[420px] w-[420px] right-[-8rem] -top-10" style="background:#0077a3;opacity:.28"></div>
    <div class="sphere sphere-dark h-[360px] w-[360px] left-[-6rem] bottom-0" style="background:#00688c;opacity:.32"></div>

    <div class="relative mx-auto max-w-7xl px-6">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl">
          <h2 class="reveal font-display text-[clamp(2.4rem,5.5vw,4.5rem)] font-extrabold leading-[1.05] tracking-tight text-white">Diseño que <br class="hidden sm:block" /><span class="text-[#00b4d8]">desafía lo común.</span></h2>
          <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-white/60 md:text-xl">Creamos experiencias digitales que no solo se ven increíbles: <strong class="font-medium text-white">convierten y escalan</strong> el negocio de nuestros clientes.</p>
        </div>
        <div class="reveal flex flex-col items-start gap-4 lg:items-end">
          <div role="group" aria-label="Filtrar proyectos" class="inline-flex flex-wrap gap-1 rounded-full border border-white/10 bg-[#111c27] p-1.5 shadow-lg">
            {folioCats.map((c, i) => (
              <button type="button" data-folio-filter={c.key} aria-pressed={i === 0 ? 'true' : 'false'} class="folio-tab rounded-full px-5 py-2.5 text-sm font-semibold text-white/60 transition-colors duration-300 hover:text-white">{c.label}</button>
            ))}
          </div>
          <p class="text-xs font-medium text-white/60">Proyectos reales, en vivo · haz clic para expandir.</p>
        </div>
      </div>

      <div class="folio-acc reveal mt-12" data-folio-acc>
        {folioItems.map((p, i) => (
          <article class={`folio-panel${i === 0 ? ' is-active' : ''}`} data-cat={p.cat}>
            <div class="folio-media">
              <Pic src={p.img} alt={`Sitio web de ${p.t}`} width={1200} height={900} sizes="(min-width:768px) 72vw, 100vw" />
            </div>
            <div class="folio-shade" aria-hidden="true"></div>
            <button type="button" class="folio-toggle" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`folio-c-${i}`} tabindex={i === 0 ? -1 : 0}>
              <span class="folio-plus" aria-hidden="true">+</span>
              <span class="folio-vtitle">{p.t}</span>
              <span class="sr-only"> — ver el proyecto</span>
            </button>
            <div class="folio-content" id={`folio-c-${i}`}>
              <div class="flex items-center gap-3">
                <span class="rounded-full border border-[#00b4d8]/30 bg-[#111c27]/80 px-3 py-1 text-xs font-bold text-[#00b4d8] backdrop-blur-sm">{p.catLabel}</span>
                <span class="text-xs font-medium text-white/60">{p.year}</span>
              </div>
              <h3 class="mt-4 font-display text-[clamp(1.75rem,3.2vw,2.5rem)] font-extrabold leading-[1.05] text-white">{p.t}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/80 md:text-[0.9375rem]">{p.desc}</p>
              {p.did && (
                <div class="mt-4 rounded-xl border border-white/10 bg-[#111c27]/60 p-3.5 backdrop-blur-md">
                  <p class="text-xs leading-relaxed text-white/80 md:text-sm"><strong class="font-bold text-[#00b4d8]">Qué resolvimos:</strong> {p.did}</p>
                </div>
              )}
              <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
                <a href={p.href} target="_blank" rel="noopener" class="group inline-flex items-center gap-2 text-sm font-semibold text-[#00b4d8] transition-colors hover:text-white">Visitar sitio en vivo <span aria-hidden="true" class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span></a>
                {p.caso && <a href={url(p.caso)} class="inline-flex items-center gap-2 text-sm font-semibold text-white transition-colors hover:text-[#00b4d8]">Ver caso del proyecto <span aria-hidden="true">→</span></a>}
              </div>
            </div>
          </article>
        ))}
      </div>

      <style>
        /* Acordeón horizontal: la fila mide ~60vh y el panel activo crece con flex-grow. */
        .folio-acc {
          container-type: size; /* da cqw/cqh a las fotos y al texto para no depender del ancho animado del panel */
          display: flex;
          gap: 12px;
          height: clamp(30rem, 60vh, 38.75rem);
        }
        .folio-panel {
          position: relative;
          flex: 0.5 1 0;
          min-width: 0;
          overflow: hidden;
          border-radius: 1.5rem;
          border: 1px solid rgba(255, 255, 255, 0.06);
          background: #111c27;
          transition: flex-grow 0.7s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.4s ease, box-shadow 0.4s ease;
        }
        .folio-panel[hidden] { display: none; }
        .folio-panel.is-active {
          flex-grow: 5;
          border-color: rgba(0, 180, 216, 0.3);
          box-shadow: 0 0 30px rgba(0, 180, 216, 0.1);
        }

        /* La foto tiene el ancho del panel ya expandido: al animar el panel solo se
           revela o recorta, no se reescala fotograma a fotograma. */
        .folio-media { position: absolute; inset: 0; }
        .folio-media :global(img) {
          position: absolute;
          top: 0;
          left: 50%;
          width: max(100%, 72cqw);
          max-width: none;
          height: 100%;
          transform: translateX(-50%);
          object-fit: cover;
          object-position: top;
        }

        /* Dos velos apilados (cambiar un degradado no se anima, la opacidad sí). */
        .folio-shade { position: absolute; inset: 0; pointer-events: none; }
        .folio-shade::before,
        .folio-shade::after { content: ''; position: absolute; inset: 0; transition: opacity 0.5s ease; }
        .folio-shade::before {
          background: linear-gradient(to top, rgba(10, 17, 24, 0.95) 0%, rgba(10, 17, 24, 0.45) 55%, rgba(10, 17, 24, 0.15) 100%);
          opacity: 0.8;
        }
        .folio-shade::after {
          background: linear-gradient(to right, rgba(10, 17, 24, 0.97) 0%, rgba(10, 17, 24, 0.93) 46%, rgba(10, 17, 24, 0.4) 76%, rgba(10, 17, 24, 0) 100%);
          opacity: 0;
        }
        .folio-panel:not(.is-active):hover .folio-shade::before { opacity: 0.55; }
        .folio-panel.is-active .folio-shade::before { opacity: 0; }
        .folio-panel.is-active .folio-shade::after { opacity: 1; }

        /* Botón que cubre la tarjeta comprimida: es lo que se pulsa y se enfoca con teclado. */
        .folio-toggle {
          position: absolute;
          inset: 0;
          z-index: 1;
          display: block;
          width: 100%;
          cursor: pointer;
          color: rgba(255, 255, 255, 0.85);
          text-align: center;
        }
        .folio-toggle:focus-visible { outline: 2px solid #00b4d8; outline-offset: -5px; border-radius: 1.5rem; }
        .folio-panel.is-active .folio-toggle { pointer-events: none; }
        .folio-plus {
          position: absolute;
          top: 1.25rem;
          left: 50%;
          display: grid;
          place-items: center;
          width: 2rem;
          height: 2rem;
          margin-left: -1rem;
          border-radius: 9999px;
          border: 1px solid rgba(0, 180, 216, 0.5);
          background: rgba(10, 17, 24, 0.6);
          color: #00b4d8;
          font-size: 1.1rem;
          line-height: 1;
          transition: opacity 0.3s ease;
        }
        .folio-vtitle {
          position: absolute;
          bottom: 1.5rem;
          left: 50%;
          writing-mode: vertical-rl;
          transform: translateX(-50%) rotate(180deg);
          white-space: nowrap;
          font-family: var(--font-display);
          font-size: 1.05rem;
          font-weight: 700;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
          transition: opacity 0.3s ease;
        }
        .folio-panel.is-active .folio-plus,
        .folio-panel.is-active .folio-vtitle { opacity: 0; }

        /* Texto del panel activo. Ancho fijo (no depende del panel animado) y oculto
           con visibility para que sus enlaces no entren en el tab mientras está cerrado. */
        .folio-content {
          position: absolute;
          bottom: 2rem;
          left: 2rem;
          z-index: 2;
          width: min(30rem, calc(68cqw - 4rem));
          opacity: 0;
          visibility: hidden;
          transform: translate(-16px, 16px);
          transition: opacity 0.25s ease, transform 0.25s ease, visibility 0s linear 0.25s;
        }
        .folio-panel.is-active .folio-content {
          opacity: 1;
          visibility: visible;
          transform: none;
          transition: opacity 0.45s ease 0.3s, transform 0.45s ease 0.3s, visibility 0s;
        }

        /* Filtros: el estado vive en aria-pressed, no en clases sueltas. */
        .folio-tab[aria-pressed='true'] { background: #fff; color: #0a1118; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3); }

        /* Móvil: el acordeón pasa a vertical y el título deja de rotarse. */
        @media (max-width: 767px) {
          .folio-acc { flex-direction: column; gap: 8px; height: clamp(48rem, 90svh, 56rem); }
          .folio-panel { border-radius: 1.25rem; }
          .folio-media :global(img) {
            left: 0;
            width: 100%;
            height: max(100%, 70cqh);
            transform: none;
          }
          /* Fila comprimida: velo parejo y denso; con degradado, la cabecera blanca de la captura se cuela detrás del título. */
          .folio-shade::before { background: rgba(10, 17, 24, 0.78); opacity: 1; }
          .folio-panel:not(.is-active):hover .folio-shade::before { opacity: 1; }
          .folio-shade::after {
            background: linear-gradient(to top, rgba(10, 17, 24, 0.97) 0%, rgba(10, 17, 24, 0.88) 60%, rgba(10, 17, 24, 0.3) 100%);
          }
          .folio-toggle { text-align: left; }
          .folio-toggle:focus-visible { border-radius: 1.25rem; }
          .folio-plus { top: 50%; left: auto; right: 1rem; margin: -1rem 0 0; }
          .folio-vtitle {
            top: 50%;
            bottom: auto;
            left: 1.25rem;
            writing-mode: horizontal-tb;
            transform: translateY(-50%);
            right: 3.5rem;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 1rem;
            letter-spacing: 0.01em;
            text-transform: none;
          }
          .folio-content { left: 1.25rem; bottom: 1rem; width: calc(100cqw - 2.5rem); transform: translateY(16px); }
        }

        /* Sin JS no hay forma de expandir: todo el contenido queda apilado y visible. */
        :global(html:not(.js)) .folio-acc { display: block; height: auto; container-type: normal; }
        :global(html:not(.js)) .folio-panel { flex: none; min-height: 30rem; margin-bottom: 12px; }
        :global(html:not(.js)) .folio-toggle,
        :global(html:not(.js)) .folio-plus,
        :global(html:not(.js)) .folio-vtitle { display: none; }
        :global(html:not(.js)) .folio-media :global(img) { left: 0; width: 100%; transform: none; }
        :global(html:not(.js)) .folio-shade::before { opacity: 0; }
        :global(html:not(.js)) .folio-shade::after { opacity: 1; background: linear-gradient(to top, rgba(10, 17, 24, 0.97) 20%, rgba(10, 17, 24, 0.3)); }
        :global(html:not(.js)) .folio-content { position: relative; inset: auto; width: auto; padding: 14rem 1.5rem 1.5rem; opacity: 1; visibility: visible; transform: none; }

        @media (prefers-reduced-motion: reduce) {
          .folio-panel, .folio-shade::before, .folio-shade::after, .folio-content, .folio-plus, .folio-vtitle { transition: none !important; }
        }
      </style>

      <div class="reveal mt-8 text-center">
