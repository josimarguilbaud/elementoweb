        </div>
      </figure>
    </div>

    <script>
      const acc = document.querySelector<HTMLElement>('[data-folio-acc]');
      if (acc) {
        const panels = [...acc.querySelectorAll<HTMLElement>('.folio-panel')];
        const tabs = document.querySelectorAll<HTMLButtonElement>('[data-folio-filter]');

        // Un solo panel abierto; el botón del abierto sale del tab (su texto ya está a la vista).
        const open = (target: HTMLElement) => {
          panels.forEach((p) => {
            const on = p === target;
            p.classList.toggle('is-active', on);
            const btn = p.querySelector<HTMLButtonElement>('.folio-toggle')!;
            btn.setAttribute('aria-expanded', String(on));
            btn.tabIndex = on ? -1 : 0;
          });
        };
        panels.forEach((p) => p.querySelector('.folio-toggle')!.addEventListener('click', () => open(p)));

        tabs.forEach((t) => t.addEventListener('click', () => {
          const k = t.dataset.folioFilter;
          tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
          panels.forEach((p) => p.classList.remove('is-active'));
          const visible = panels.filter((p) => {
            const show = k === 'all' || p.dataset.cat === k;
            p.hidden = !show;
            return show;
          });
          // Reflow antes de abrir: así el primer panel visible anima desde comprimido en vez de aparecer ya abierto.
          void acc.offsetWidth;
          if (visible[0]) open(visible[0]);
        }));
      }
    </script>
  </section>

