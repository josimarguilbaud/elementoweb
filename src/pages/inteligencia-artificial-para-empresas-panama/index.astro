  <style>
    /* Tabs de departamentos */
    .dep-tab { color: #64748b; }
    .dep-tab:hover:not(.is-active) { background: rgba(15, 23, 42, 0.04); color: #334155; }
    .dep-tab.is-active { background: #fff; color: var(--color-teal-deep); box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06); border: 1px solid rgba(15, 23, 42, 0.06); }
    .dep-pane { display: none; }
    .dep-pane.is-active { display: block; animation: depIn 0.4s ease; }
    @keyframes depIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    /* Highlight de la fuente en el chat RAG */
    #ia-source.lit { border-color: rgba(15, 118, 110, 0.5); background: rgba(15, 118, 110, 0.08); }

    /* Punto que fluye por los conectores del mock de automatización */
    .flow-dot { position: absolute; left: 50%; top: -20%; width: 6px; height: 6px; margin-left: -3px; border-radius: 9999px; background: var(--color-violet); box-shadow: 0 0 10px var(--color-violet); animation: flowY 2.6s ease-in-out infinite; }
    @keyframes flowY { 0% { top: -20%; opacity: 0; } 20% { opacity: 1; } 80% { opacity: 1; } 100% { top: 120%; opacity: 0; } }

    @media (prefers-reduced-motion: reduce) {
      .dep-pane.is-active { animation: none; }
      .flow-dot { animation: none; opacity: 0; }
    }
  </style>

  <script>
    // ===== Tabs de departamentos =====
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.dep-tab'));
    const panes = Array.from(document.querySelectorAll<HTMLElement>('.dep-pane'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('is-active'));
        panes.forEach((p) => p.classList.remove('is-active'));
        tab.classList.add('is-active');
        const id = tab.getAttribute('data-target');
        if (id) document.getElementById(id)?.classList.add('is-active');
      });
    });

    // ===== Animación del chat RAG (en loop, respeta reduced-motion) =====
    const thinking = document.getElementById('ia-thinking');
    const answer = document.getElementById('ia-answer');
    const typed = document.getElementById('ia-typed');
    const source = document.getElementById('ia-source');
    const fullText =
      'Según Politicas_2025.docx (Pág. 14), los clientes VIP tienen un periodo de devolución extendido de 60 días, sin costo de envío ni preguntas.';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    function typeText(i: number) {
      if (!typed) return;
      if (i <= fullText.length) {
        typed.textContent = fullText.slice(0, i);
        setTimeout(() => typeText(i + 1), 28);
      } else {
        setTimeout(() => { source?.classList.remove('lit'); setTimeout(runChat, 3500); }, 4500);
      }
    }
    function runChat() {
      if (!thinking || !answer || !typed) return;
      thinking.classList.remove('hidden');
      thinking.style.opacity = '1';
      answer.classList.add('hidden');
      answer.style.opacity = '0';
      typed.textContent = '';
      source?.classList.remove('lit');
      setTimeout(() => source?.classList.add('lit'), 700);
      setTimeout(() => {
        thinking.style.opacity = '0';
        setTimeout(() => {
          thinking.classList.add('hidden');
          answer.classList.remove('hidden');
          setTimeout(() => { answer.style.opacity = '1'; typeText(0); }, 60);
        }, 300);
      }, 1900);
    }
    if (thinking && answer && typed) {
      if (reduce) {
        thinking.classList.add('hidden');
        answer.classList.remove('hidden');
        answer.style.opacity = '1';
        source?.classList.add('lit');
        typed.textContent = fullText;
      } else {
        setTimeout(runChat, 900);
      }
    }
  </script>
