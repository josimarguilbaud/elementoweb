---
import Base from '../../layouts/Base.astro';
import { site, url, wa } from '../../lib/site';
import { orgNode } from '../../lib/schema';

const slug = 'inteligencia-artificial-para-empresas-panama';
const title = 'Inteligencia Artificial para Empresas en Panamá | Elemento Web';
const description =
  'Implementamos un ecosistema de IA privado para tu empresa: una base de conocimiento (RAG) y automatización de procesos que trabajan 24/7, siempre con control humano.';

/* CTAs */
const waDiag = wa('Hola, quiero un diagnóstico del ecosistema de IA para mi empresa.');

/* Departamentos (tabs) */
const departamentos = [
  {
    id: 'ventas',
    label: 'Ventas y CRM',
    icon: 'handshake',
    h: 'Cierre de acuerdos sin fricción',
    p: 'El equipo comercial pierde gran parte del día en tareas administrativas. El ecosistema se las quita de encima.',
    rag: 'Lee el historial completo de correos y propuestas y sugiere la siguiente mejor acción basándose en acuerdos pasados que sí cerraron.',
    accion: 'Genera la cotización o el contrato y lo mueve al CRM apenas la oportunidad cambia de etapa. Sin copiar y pegar.',
    tags: ['HubSpot', 'Salesforce', 'WhatsApp'],
  },
  {
    id: 'rrhh',
    label: 'Recursos Humanos',
    icon: 'users',
    h: 'Onboarding y asistencia autónoma',
    p: 'Libera a Recursos Humanos de las mismas preguntas de siempre y automatiza el ingreso de personal.',
    rag: 'Un asistente que responde al instante sobre vacaciones, planilla o políticas internas leyendo el manual del empleado, con la cita exacta.',
    accion: 'Coordina entrevistas, crea el correo y los accesos al software del nuevo empleado el primer día, sin intervención manual.',
    tags: ['Slack', 'Google Workspace', 'Manual interno'],
  },
  {
    id: 'finanzas',
    label: 'Finanzas',
    icon: 'invoice',
    h: 'Extracción y conciliación inteligente',
    p: 'Convierte documentos desordenados (fotos, facturas, recibos) en datos limpios dentro de tu sistema.',
    rag: 'Lee facturas escaneadas y extrae montos, proveedores e impuestos sin plantillas rígidas de OCR.',
    accion: 'Cruza el monto con la orden de compra y, si coincide, pre-aprueba el pago y notifica a quien decide. El pago final lo aprueba una persona.',
    tags: ['ERP', 'Contabilidad', 'Visión IA'],
  },
  {
    id: 'soporte',
    label: 'Soporte e IT',
    icon: 'headset',
    h: 'Soporte de primer nivel autónomo',
    p: 'Tus agentes intervienen solo cuando su criterio y empatía hacen la diferencia. El resto lo filtra la IA.',
    rag: 'Analiza cada ticket entrante, entiende el problema consultando el historial y los manuales de producto.',
    accion: 'Resuelve las consultas repetitivas al momento. Lo que necesita un humano, lo categoriza, prioriza y lo asigna al experto correcto.',
    tags: ['Zendesk', 'Jira', 'Base de conocimiento'],
  },
];

/* FAQ — fuente única: alimenta el bloque visible y el FAQPage JSON-LD */
const faqs = [
  {
    q: '¿Mis datos quedan expuestos o se usan para entrenar modelos públicos?',
    a: 'No. Trabajamos sobre un entorno privado y aislado. Tus documentos y datos se usan solo para responder a tu empresa; no se comparten con modelos públicos ni se usan para entrenarlos. El acceso respeta los permisos que cada persona ya tiene en tu organización.',
  },
  {
    q: '¿Tengo que cambiar los sistemas que ya uso?',
    a: 'No. El ecosistema se conecta a lo que ya tienes vía API o con automatización (n8n): correo, CRM, ERP, hojas de cálculo, Drive, WhatsApp y más. La idea es potenciar tu operación actual, no obligarte a migrar todo.',
  },
  {
    q: '¿Y si la IA se equivoca en algo importante?',
    a: 'Por diseño, las acciones sensibles (pagos, correos externos, cambios críticos) se detienen y esperan la aprobación de una persona. Es un copiloto, no un piloto automático a ciegas. Tú decides dónde poner esos puntos de control.',
  },
  {
    q: '¿Cuánto tarda en implementarse?',
    a: 'Empezamos con un diagnóstico y un piloto acotado a un proceso concreto, para que veas resultados sin comprometer toda la operación. A partir de ahí escalamos. El tiempo exacto depende del alcance, y lo definimos por escrito antes de empezar.',
  },
  {
    q: '¿Cuánto cuesta?',
    a: 'Es un proyecto a medida: la inversión depende de cuántos procesos automatizamos, qué integraciones necesita y el volumen de tu operación. Cerramos la cotización por escrito antes de arrancar, sin sorpresas a mitad de camino. El diagnóstico inicial no tiene costo.',
  },
  {
    q: '¿Necesito un equipo técnico interno para mantenerlo?',
    a: 'No es obligatorio. Somos una software house: construimos, operamos y mantenemos el ecosistema como un servicio. Si tu equipo quiere involucrarse, lo documentamos y los capacitamos.',
  },
];

/* JSON-LD: organización + servicio + breadcrumb + FAQPage (derivado del mismo array) */
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    orgNode(),
    {
      '@type': 'Service',
      '@id': `${site.domain}${url(slug)}#servicio`,
      name: 'Ecosistema de Inteligencia Artificial Empresarial',
      serviceType: 'Implementación de IA privada (RAG) y automatización de procesos',
      description,
      provider: { '@id': `${site.domain}/#organizacion` },
      areaServed: { '@type': 'Country', name: 'Panamá' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.domain}/` },
        { '@type': 'ListItem', position: 2, name: 'Inteligencia Artificial para Empresas', item: `${site.domain}${url(slug)}` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<Base title={title} description={description} current="funcionalidades" dark={true} jsonld={jsonld}>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-ink pt-36 pb-24 text-white md:pt-44 md:pb-32">
    <div class="absolute inset-0 mesh-dark opacity-60"></div>
    <div class="sphere sphere-dark h-[560px] w-[560px] -left-40 -top-32" style="background:#0f766e;opacity:.5"></div>
    <div class="sphere sphere-dark h-[460px] w-[460px] right-[-8rem] top-10" style="background:#8b5cf6;opacity:.45"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <p class="reveal mx-auto mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.06] px-4 py-1.5 text-xs font-semibold tracking-wide text-white/80 backdrop-blur">
        <span class="grid h-4 w-4 place-items-center rounded-full bg-teal text-ink"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z" stroke-linejoin="round" /></svg></span>
        Inteligencia artificial para empresas · Panamá
      </p>
      <h1 class="reveal font-display text-[clamp(2.5rem,6.5vw,5rem)] font-extrabold leading-[0.98] tracking-tight">Tu empresa, ahora con un <span class="grad-text">cerebro propio</span>.</h1>
      <p class="reveal mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-white/65 md:text-xl">No solo centralizamos tu información: la ponemos a trabajar. Unimos una IA privada que entiende tu negocio con automatización de procesos, para que tu equipo le deje el trabajo robótico a los robots.</p>
      <div class="reveal mt-10 flex flex-wrap justify-center gap-3">
        <a href="/contacto/" data-magnetic="0.4" class="group inline-flex items-center gap-3 rounded-full bg-teal px-7 py-4 text-base font-semibold text-ink shadow-2xl shadow-teal/25 transition-colors hover:bg-white">Agendar diagnóstico gratuito <span class="grid h-6 w-6 place-items-center rounded-full bg-ink/10 text-ink transition-transform group-hover:translate-x-0.5"><svg width="10" height="10" viewBox="0 0 8 8" fill="none"><path d="M1 7 7 1M7 1H2M7 1v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>
        <a href="#flujo" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-7 py-4 text-base font-semibold text-white transition-colors hover:border-white/50">Ver cómo funciona</a>
      </div>
      <!-- Principios de arquitectura (honestos, no certificaciones) -->
      <div class="reveal mx-auto mt-14 flex max-w-3xl flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-white/55">
        <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke-linecap="round" /></svg> Entorno privado y aislado</span>
        <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2"><path d="M12 3 4 6v6c0 4 3.5 6.5 8 8 4.5-1.5 8-4 8-8V6l-8-3Z" /><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /></svg> Tus datos no entrenan modelos públicos</span>
        <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2"><path d="M12 3 4 6v6c0 4 3.5 6.5 8 8 4.5-1.5 8-4 8-8V6l-8-3Z" /></svg> Control humano en decisiones críticas</span>
        <span class="inline-flex items-center gap-2"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2dd4bf" stroke-width="2"><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="12" r="9" /></svg> Meta Verified Tech Provider</span>
      </div>
    </div>
  </section>

  <!-- ============ FLUJO: del dato a la acción ============ -->
  <section id="flujo" class="relative bg-paper py-24 md:py-28">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mx-auto mb-14 max-w-2xl text-center">
        <p class="reveal mb-4 inline-block rounded-full border border-ink/10 bg-white px-4 py-1.5 text-xs font-semibold text-ink/60">El poder del ecosistema</p>
        <h2 class="reveal font-display text-[clamp(1.9rem,4.4vw,3.2rem)] font-extrabold leading-[1.04] text-ink">Del dato a la acción, <span class="grad-text">sin manos en el medio</span>.</h2>
        <p class="reveal mt-5 text-lg text-ink/55">Un ejemplo real: entra un correo, la IA lo entiende, un humano aprueba y el sistema ejecuta.</p>
      </div>

      <div class="reveal relative grid grid-cols-1 gap-4 lg:grid-cols-4">
        <!-- línea conectora desktop -->
        <div class="pointer-events-none absolute left-[12%] right-[12%] top-[38px] hidden h-0.5 bg-ink/10 lg:block"></div>
        <!-- 1 -->
        <div class="relative z-10 flex flex-col rounded-2xl border border-ink/10 bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-full bg-ink/[0.04] text-ink/70"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
          <h3 class="mb-2 font-display text-base font-bold text-ink">1. El detonante</h3>
          <p class="text-sm text-ink/55">Entra el correo de un cliente VIP pidiendo un reembolso.</p>
        </div>
        <!-- 2 -->
        <div class="relative z-10 flex flex-col rounded-2xl border border-teal-deep/25 bg-white p-6 text-center" style="box-shadow:0 14px 40px -18px rgba(15,118,110,.35)">
          <div class="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-full bg-teal-deep/10 text-teal-deep"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5a3 3 0 0 0-3 3 3 3 0 0 0-2 5.2A3 3 0 0 0 9 18a3 3 0 0 0 6 0 3 3 0 0 0 2-4.8A3 3 0 0 0 15 8a3 3 0 0 0-3-3Z" /></svg></div>
          <h3 class="mb-2 font-display text-base font-bold text-ink">2. La IA entiende</h3>
          <p class="text-sm text-ink/55">Lee tu política de devoluciones y valida el pedido en tu sistema.</p>
        </div>
        <!-- 3 -->
        <div class="relative z-10 flex flex-col rounded-2xl border border-amber-400/40 bg-gradient-to-b from-white to-amber-50/60 p-6 text-center" style="box-shadow:0 14px 40px -18px rgba(245,158,11,.3)">
          <div class="relative mx-auto mb-4 grid h-14 w-14 place-items-center rounded-full bg-amber-400/15 text-amber-500">
            <span class="absolute -right-0.5 -top-0.5 flex h-3 w-3"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-70"></span><span class="relative inline-flex h-3 w-3 rounded-full border-2 border-white bg-amber-500"></span></span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 11V7a4 4 0 0 0-8 0v4" /><rect x="5" y="11" width="14" height="9" rx="2" /><path d="m9.5 15 1.5 1.5 3.5-3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
          <h3 class="mb-2 font-display text-base font-bold text-ink">3. Aprobación humana</h3>
          <p class="text-sm text-ink/55">Pausa inteligente: avisa al responsable con la opción de aprobar.</p>
        </div>
        <!-- 4 -->
        <div class="relative z-10 flex flex-col rounded-2xl border border-violet/30 bg-white p-6 text-center" style="box-shadow:0 14px 40px -18px rgba(139,92,246,.3)">
          <div class="mx-auto mb-4 grid h-14 w-14 place-items-center rounded-full bg-violet/10 text-violet"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z" stroke-linejoin="round" /></svg></div>
          <h3 class="mb-2 font-display text-base font-bold text-ink">4. Ejecución</h3>
          <p class="text-sm text-ink/55">Con el visto bueno, genera la nota de crédito y redacta el correo final.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RAG: entendimiento ============ -->
  <section class="relative bg-white py-24 md:py-28">
    <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2">
      <div class="order-2 lg:order-1 lg:pr-8">
        <div class="reveal mb-6 inline-flex items-center gap-2 rounded-full bg-teal-deep/10 px-3 py-1 text-xs font-bold text-teal-deep">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3" /><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" /></svg>
          Entendimiento · Base de conocimiento (RAG)
        </div>
        <h2 class="reveal font-display text-[clamp(1.9rem,4vw,3rem)] font-extrabold leading-[1.05] text-ink">Una IA privada entrenada con el <span class="grad-text">ADN de tu empresa</span>.</h2>
        <p class="reveal mt-6 text-lg text-ink/60">Despídete de los manuales que nadie lee y de las horas perdidas buscando en carpetas. Tu equipo pregunta en lenguaje natural y obtiene respuestas precisas, con la cita exacta al documento.</p>
        <ul class="mt-8 space-y-6">
          <li class="reveal flex items-start gap-4">
            <div class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-teal-deep/10 text-teal-deep"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg></div>
            <div><h4 class="font-display font-bold text-ink">De búsqueda a respuesta</h4><p class="text-sm text-ink/60">No busca: responde. En lenguaje natural y con citas exactas a tus propios documentos.</p></div>
          </li>
          <li class="reveal flex items-start gap-4">
            <div class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-teal-deep/10 text-teal-deep"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3 4 6v6c0 4 3.5 6.5 8 8 4.5-1.5 8-4 8-8V6l-8-3Z" /></svg></div>
            <div><h4 class="font-display font-bold text-ink">Privacidad de grado empresarial</h4><p class="text-sm text-ink/60">Entorno cerrado. Tus manuales y hojas de cálculo nunca se comparten con modelos públicos.</p></div>
          </li>
          <li class="reveal flex items-start gap-4">
            <div class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-teal-deep/10 text-teal-deep"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 3v5h-5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
            <div><h4 class="font-display font-bold text-ink">Multi-formato y sincronizado</h4><p class="text-sm text-ink/60">PDF, Word, Drive y más. Actualizas un documento y la IA lo asimila al instante.</p></div>
          </li>
        </ul>
        <a href="/funcionalidades/chatbots-ia-web-chatmantis-panama/" class="reveal mt-9 inline-flex items-center gap-2 rounded-lg border border-teal-deep/20 bg-teal-deep/10 px-6 py-3 font-medium text-teal-deep transition-colors hover:bg-teal-deep hover:text-white">Ver nuestra IA conversacional <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>

      <!-- Mock: chat RAG -->
      <div class="reveal order-1 flex h-[500px] flex-col overflow-hidden rounded-2xl border border-ink/10 bg-white shadow-xl lg:order-2">
        <div class="flex items-center justify-between border-b border-ink/10 bg-paper p-4">
          <div class="flex items-center gap-3">
            <div class="grid h-8 w-8 place-items-center rounded bg-teal-deep/10 text-teal-deep"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="8" width="16" height="12" rx="2" /><path d="M12 8V4M9 4h6" stroke-linecap="round" /><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none" /><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none" /></svg></div>
            <div><div class="text-sm font-bold text-ink">IA Corporativa</div><div class="flex items-center gap-1 text-xs text-emerald-600"><span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span> En línea</div></div>
          </div>
          <div class="rounded border border-ink/10 bg-white px-2 py-1 text-xs text-ink/50 shadow-sm">Privado y seguro</div>
        </div>
        <div class="flex flex-1 overflow-hidden">
          <!-- fuentes -->
          <div class="flex w-1/3 flex-col border-r border-ink/10 bg-paper p-4">
            <div class="mb-3 text-[11px] font-semibold tracking-wider text-ink/45">FUENTES ACTIVAS</div>
            <div class="flex-1 space-y-2.5">
              <div class="flex items-center gap-2 rounded border border-ink/10 bg-white p-2 shadow-sm"><span class="text-red-500"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h9l5 5v15H6z" opacity=".15" /><path d="M14 2v6h6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span><span class="truncate text-[11px] text-ink/70">Manual_Ventas.pdf</span></div>
              <div id="ia-source" class="relative flex items-center gap-2 overflow-hidden rounded border border-ink/10 bg-white p-2 shadow-sm transition-colors"><span class="text-blue-500"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h9l5 5v15H6z" opacity=".15" /><path d="M14 2v6h6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span><span class="truncate text-[11px] font-medium text-ink/80">Politicas_2025.docx</span></div>
              <div class="flex items-center gap-2 rounded border border-ink/10 bg-white p-2 shadow-sm"><span class="text-emerald-600"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h9l5 5v15H6z" opacity=".15" /><path d="M14 2v6h6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span><span class="truncate text-[11px] text-ink/70">Inventario_Q3.xlsx</span></div>
            </div>
            <div class="mt-3 rounded border border-emerald-100 bg-emerald-50 py-1 text-center text-[10px] text-emerald-700">Sincronizado hace 2m</div>
          </div>
          <!-- chat -->
          <div class="flex w-2/3 flex-col justify-end bg-white p-4">
            <div class="mb-4 space-y-3">
              <div class="flex justify-end"><div class="max-w-[85%] rounded-2xl rounded-tr-none bg-ink px-3 py-2 text-sm text-white shadow-md">¿Cuál es la política de devoluciones para clientes VIP?</div></div>
              <div id="ia-thinking" class="flex justify-start transition-opacity duration-300"><div class="flex items-center gap-2 rounded-lg border border-teal-deep/20 bg-teal-deep/5 p-2 text-xs text-teal-deep shadow-sm"><svg class="animate-spin" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.2-8.5" stroke-linecap="round" /></svg> Analizando 3 documentos…</div></div>
              <div id="ia-answer" class="hidden justify-start opacity-0 transition-opacity duration-500">
                <div class="max-w-[95%] rounded-2xl rounded-tl-none border border-ink/10 bg-white p-4 text-sm text-ink/80 shadow-md">
                  <p id="ia-typed"></p>
                  <div class="mt-3 border-t border-ink/[0.06] pt-3"><span class="inline-flex items-center gap-1 rounded border border-ink/10 bg-paper px-2 py-1 text-[10px] text-ink/60"><span class="text-blue-500"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M6 2h9l5 5v15H6z" opacity=".2" /></svg></span> Politicas_2025.docx · Pág. 14</span></div>
                </div>
              </div>
            </div>
            <div class="mt-auto flex items-center gap-2 rounded-full border border-ink/10 bg-paper p-2 shadow-inner">
              <svg class="ml-2 text-ink/40" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" stroke-linecap="round" /></svg>
              <input type="text" placeholder="Pregunta a tus documentos…" class="w-full border-none bg-transparent text-sm text-ink outline-none placeholder-ink/40" disabled />
