---
/* Estudio de precios publicados por agencias de Panamá (D62). Los datos salen de src/data/estudio-precios-2026.json:
   una fila por agencia y servicio, con el precio tal como lo publica su web, el enlace y la fecha de consulta. Nada se
   estima: si una agencia no publica un precio, no está. Se actualiza cada trimestre (cambiar `consultado` y las filas).
   Las fuentes se enlazan con rel="nofollow": se citan, no se recomiendan. Elemento Web no entra en la muestra. */
import Base from '../../../layouts/Base.astro';
import ContactForm from '../../../components/ContactForm.astro';
import { site } from '../../../lib/site';
import { orgNode, webSiteNode } from '../../../lib/schema';
import estudio from '../../../data/estudio-precios-2026.json';

type Fila = { agencia: string; url: string; servicio: string; precio_min: number | null; precio_max: number | null; desde: boolean; unidad: string; texto: string; consultado: string; nota?: string };
/* Con menos de 5 agencias la mediana no es representativa: se muestran los datos, sin mediana. */
const MUESTRA_MINIMA = 5;
const filas = estudio.filas as Fila[];
const SERVICIOS: [string, string][] = [
  ['landing', 'Landing page'], ['web corporativa', 'Web corporativa'], ['tienda online', 'Tienda online'],
  ['seo mensual', 'SEO (al mes)'], ['pauta mensual', 'Gestión de Google o Meta Ads (al mes)'], ['chatbot ia', 'Chatbot o agente de IA'], ['mantenimiento', 'Mantenimiento web'],
];
const mediana = (xs: number[]) => { const o = [...xs].sort((a, b) => a - b); const m = Math.floor(o.length / 2); return o.length % 2 ? o[m] : (o[m - 1] + o[m]) / 2; };
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const resumen = SERVICIOS.map(([clave, nombre]) => {
  const del = filas.filter((f) => f.servicio === clave && f.precio_min != null);
  const xs = del.map((f) => f.precio_min as number);
  return { clave, nombre, n: del.length, min: xs.length ? Math.min(...xs) : null, med: xs.length ? mediana(xs) : null, max: xs.length ? Math.max(...del.map((f) => (f.precio_max ?? f.precio_min) as number)) : null, filas: del };
}).filter((r) => r.n > 0);
const agencias = new Set(filas.map((f) => f.agencia)).size;
const fecha = estudio.consultado;
const fechaTexto = new Date(`${fecha}T12:00:00Z`).toLocaleDateString('es-PA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const slug = 'recursos/precios-agencias-panama-2026';
const pageUrl = `${site.domain}/${slug}/`;
const title = 'Precios de agencias de marketing y diseño web en Panamá 2026';
const description = `Estudio con los precios que publican ${agencias} agencias de Panamá: landing, web, tienda, SEO, pauta y chatbots. Mínimo, mediana y máximo, con fuente y fecha.`;
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    orgNode(), webSiteNode(),
    {
      '@type': 'Dataset', '@id': `${pageUrl}#datos`, name: title, description, url: pageUrl, inLanguage: 'es-PA',
      datePublished: '2026-10-23', dateModified: fecha, creator: { '@id': `${site.domain}/#organizacion` },
      spatialCoverage: { '@type': 'Country', name: 'Panamá' }, isAccessibleForFree: true,
      variableMeasured: resumen.map((r) => `Precio publicado: ${r.nombre} (USD)`),
      measurementTechnique: 'Lectura de los precios publicados en la web de cada agencia, con enlace y fecha de consulta; sin estimaciones.',
    },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.domain}/` },
      { '@type': 'ListItem', position: 2, name: 'Recursos', item: `${site.domain}/recursos/` },
      { '@type': 'ListItem', position: 3, name: 'Precios de agencias 2026', item: pageUrl },
    ] },
  ],
});
---
<Base title={title} description={description} jsonld={jsonld} dark>
  <section class="bg-humo pb-14 pt-[calc(var(--nav-h)+40px)] text-negro md:pt-[calc(var(--nav-h)+72px)]">
    <div class="mx-auto max-w-4xl px-6">
      <nav aria-label="Ruta de navegación" class="text-sm text-gris-texto"><a href="/" class="underline underline-offset-2 hover:text-negro">Inicio</a> <span aria-hidden="true">/</span> <a href="/recursos/" class="underline underline-offset-2 hover:text-negro">Recursos</a> <span aria-hidden="true">/</span> <span class="text-negro">Precios de agencias 2026</span></nav>
      <h1 class="mt-5 font-display text-[clamp(2rem,5vw,3.4rem)] font-extrabold leading-[1.05]">Precios de agencias de marketing y diseño web en Panamá, 2026</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gris-texto">Juntamos los precios que {agencias} agencias de Panamá publican en su propia web. Cada cifra enlaza a su fuente. Datos consultados el <time datetime={fecha}>{fechaTexto}</time>; los actualizamos cada trimestre.</p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-14">
    <h2 class="font-display text-2xl font-extrabold text-negro">Resumen por servicio</h2>
    <p class="mt-2 text-sm text-gris-texto">Precio de partida publicado, en dólares. «Mediana» es el valor del medio de la muestra: la mitad de las agencias publica menos y la otra mitad más. Con menos de 5 agencias no la calculamos.</p>
    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <caption class="sr-only">Precios publicados por servicio: mínimo, mediana y máximo</caption>
        <thead><tr class="border-b-2 border-negro"><th scope="col" class="py-3 pr-4 font-semibold">Servicio</th><th scope="col" class="py-3 pr-4 font-semibold">Agencias</th><th scope="col" class="py-3 pr-4 font-semibold">Mínimo</th><th scope="col" class="py-3 pr-4 font-semibold">Mediana</th><th scope="col" class="py-3 font-semibold">Máximo</th></tr></thead>
        <tbody>
          {resumen.map((r) => (
            <tr class="border-b border-filete"><th scope="row" class="py-3 pr-4 font-medium">{r.nombre}</th><td class="py-3 pr-4">{r.n}</td><td class="py-3 pr-4">{usd(r.min!)}</td><td class="py-3 pr-4 font-semibold">{r.n >= MUESTRA_MINIMA ? usd(r.med!) : <span class="font-normal text-gris-texto">muestra pequeña</span>}</td><td class="py-3">{usd(r.max!)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-14 font-display text-2xl font-extrabold text-negro">Los datos, uno por uno</h2>
    <p class="mt-2 text-sm text-gris-texto">Cada fila cita lo que dice la web de la agencia. Las enlazamos para que puedas verificarlas; no es una recomendación.</p>
    {resumen.map((r) => (
      <div class="mt-8">
        <h3 class="font-display text-lg font-bold text-negro">{r.nombre}</h3>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[560px] border-collapse text-left text-sm">
            <caption class="sr-only">{r.nombre}: precios publicados por agencia</caption>
            <thead><tr class="border-b border-negro"><th scope="col" class="py-2 pr-4 font-semibold">Agencia</th><th scope="col" class="py-2 pr-4 font-semibold">Precio publicado</th><th scope="col" class="py-2 font-semibold">Lo que dice su web</th></tr></thead>
            <tbody>
              {r.filas.map((f) => (
                <tr class="border-b border-filete align-top"><td class="py-2 pr-4"><a href={f.url} rel="nofollow noopener" target="_blank" class="underline underline-offset-2">{f.agencia}<span class="sr-only"> (se abre en otra pestaña)</span></a></td><td class="py-2 pr-4 whitespace-nowrap">{f.desde ? 'desde ' : ''}{usd(f.precio_min!)}{f.precio_max && f.precio_max !== f.precio_min ? ` a ${usd(f.precio_max)}` : ''}{f.unidad === 'mes' ? ' al mes' : ''}</td><td class="py-2 text-gris-texto">«{f.texto}»{f.nota && <span class="mt-1 block text-xs">{f.nota}</span>}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ))}

    <div class="mt-14 rounded-2xl border border-filete bg-white p-6 text-sm leading-relaxed text-gris-texto">
      <h2 class="font-display text-lg font-bold text-negro">Método y límites</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5">
        <li>Solo precios publicados en la web de cada agencia, leídos y enlazados el día de la consulta. Si una agencia no publica precio, no está en la muestra.</li>
        <li>Un precio «desde» es el de entrada: el proyecto real suele costar más según el alcance.</li>
        <li>Las agencias cobran la gestión de la pauta aparte de la inversión publicitaria, que se paga a Google o Meta.</li>
        <li>No comparamos calidad, plazos ni lo que incluye cada precio. Antes de elegir, pide el alcance por escrito.</li>
        <li>Elemento Web no está en la muestra. Nuestros precios están en <a href="/precios/" class="font-semibold text-negro underline">precios</a> y en <a href="/soluciones/" class="font-semibold text-negro underline">soluciones</a>; somos una <a href="/" class="font-semibold text-negro underline">agencia de marketing digital en Panamá</a>.</li>
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-6 pb-20">
    <h2 class="text-center font-display text-[clamp(1.6rem,3.5vw,2.4rem)] font-extrabold text-negro">¿Quieres una cotización cerrada para comparar?</h2>
    <p class="mx-auto mt-3 max-w-xl text-center text-lg text-gris-texto">Te respondemos el mismo día hábil con alcance, plazo y precio por escrito.</p>
    <div class="mt-8"><ContactForm /></div>
  </section>
</Base>
